<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Palette taken from the Zero Hour logo and control bar: molten gold, brushed steel and dark gunmetal.
         Gold marks identity, selection and the primary action only; every status also carries a shape and a word. -->
    <Color x:Key="Bg0Color">#08090A</Color>
    <Color x:Key="PanelAColor">#1A1D1F</Color>
    <Color x:Key="PanelBColor">#111315</Color>
    <Color x:Key="LineColor">#2B3033</Color>
    <Color x:Key="LineHiColor">#3E4549</Color>
    <Color x:Key="SteelColor">#CDD3D8</Color>
    <Color x:Key="TextColor">#E9E5DB</Color>
    <Color x:Key="Text2Color">#B9BFBE</Color>
    <Color x:Key="Text3Color">#969D9F</Color>
    <Color x:Key="IconIdleColor">#7D8588</Color>
    <Color x:Key="AccentColor">#F0A51B</Color>
    <Color x:Key="AccentHiColor">#FFC54D</Color>
    <Color x:Key="AccentLoColor">#C27A0C</Color>
    <Color x:Key="WarnColor">#FFD04A</Color>
    <Color x:Key="InfoColor">#5BC0EB</Color>
    <Color x:Key="DangerColor">#E2553F</Color>
    <Color x:Key="OkColor">#7FCA4C</Color>
    <Color x:Key="UsaColor">#4E8FE0</Color>
    <Color x:Key="ChinaColor">#E04B3B</Color>
    <Color x:Key="GlaColor">#C8A64A</Color>

    <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}"/>
    <SolidColorBrush x:Key="PanelA" Color="{StaticResource PanelAColor}"/>
    <SolidColorBrush x:Key="PanelB" Color="{StaticResource PanelBColor}"/>
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="LineHi" Color="{StaticResource LineHiColor}"/>
    <SolidColorBrush x:Key="Steel" Color="{StaticResource SteelColor}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="Text2" Color="{StaticResource Text2Color}"/>
    <SolidColorBrush x:Key="Text3" Color="{StaticResource Text3Color}"/>
    <SolidColorBrush x:Key="IconIdle" Color="{StaticResource IconIdleColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHi" Color="{StaticResource AccentHiColor}"/>
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="Info" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="Usa" Color="{StaticResource UsaColor}"/>
    <SolidColorBrush x:Key="China" Color="{StaticResource ChinaColor}"/>
    <SolidColorBrush x:Key="Gla" Color="{StaticResource GlaColor}"/>

    <SolidColorBrush x:Key="AccentSoft" Color="#24F0A51B"/>
    <SolidColorBrush x:Key="AccentLine" Color="#5A4518"/>
    <SolidColorBrush x:Key="NavActiveText" Color="#F5E6C4"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#1AFFD04A"/>
    <SolidColorBrush x:Key="WarnLine" Color="#6B5A1E"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#1AE2553F"/>
    <SolidColorBrush x:Key="DangerLine" Color="#5A241C"/>
    <SolidColorBrush x:Key="OkSoft" Color="#147FCA4C"/>
    <SolidColorBrush x:Key="OkLine" Color="#2F4A22"/>
    <SolidColorBrush x:Key="InfoSoft" Color="#145BC0EB"/>
    <SolidColorBrush x:Key="InfoLine" Color="#1F4A60"/>
    <SolidColorBrush x:Key="InputBg" Color="#0B0D0E"/>
    <SolidColorBrush x:Key="InputLine" Color="#353B3F"/>
    <SolidColorBrush x:Key="RowHover" Color="#0FFFFFFF"/>

    <LinearGradientBrush x:Key="PanelFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EE1A1D1F" Offset="0"/>
        <GradientStop Color="#F2111315" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A5155" Offset="0"/>
        <GradientStop Color="#2A2F32" Offset="0.4"/>
        <GradientStop Color="#1D2124" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SideFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EB141618" Offset="0"/>
        <GradientStop Color="#F50A0B0C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TopFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E60E0F11" Offset="0"/>
        <GradientStop Color="#8C0E0F11" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BarFill" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#FA0A0B0C" Offset="0"/>
        <GradientStop Color="#E00E0F11" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFD06A" Offset="0"/>
        <GradientStop Color="#F2A51C" Offset="0.52"/>
        <GradientStop Color="#CF850E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldFillHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFDB85" Offset="0"/>
        <GradientStop Color="#FFB532" Offset="0.52"/>
        <GradientStop Color="#DD9318" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SteelFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2C3134" Offset="0"/>
        <GradientStop Color="#191C1E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SteelFillHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#363C40" Offset="0"/>
        <GradientStop Color="#202427" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A1916" Offset="0"/>
        <GradientStop Color="#160D0C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TileFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1F2326" Offset="0"/>
        <GradientStop Color="#151719" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Divider" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#003E4549" Offset="0"/>
        <GradientStop Color="#FF3E4549" Offset="0.5"/>
        <GradientStop Color="#003E4549" Offset="1"/>
    </LinearGradientBrush>

    <!-- Bahnschrift ships with Windows 10 and 11; the condensed face is reached through FontStretch. -->
    <FontFamily x:Key="UiFont">Bahnschrift, Segoe UI</FontFamily>
    <sys:Double x:Key="Fs.Small">12</sys:Double>
    <sys:Double x:Key="Fs.Body">14</sys:Double>
    <sys:Double x:Key="Fs.Lead">15</sys:Double>

    <Duration x:Key="Quick">0:0:0.12</Duration>
</ResourceDictionary>
