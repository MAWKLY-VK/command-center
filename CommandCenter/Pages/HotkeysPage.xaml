<UserControl x:Class="CommandCenter.Pages.HotkeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CommandCenter.Controls"
             Focusable="True" PreviewKeyDown="Page_PreviewKeyDown">
    <UserControl.Resources>
        <DataTemplate x:Key="MenuTemplate">
            <DockPanel Height="38" Margin="18,0,14,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <ui:StatusMark DockPanel.Dock="Right" Mark="{Binding Mark}" Width="12" Height="12" VerticalAlignment="Center" ToolTip="{Binding MarkTip}"/>
                <TextBlock Text="{Binding Name}" FontSize="14.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="GameKeyTemplate">
            <Grid Height="44" Margin="18,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Default}" Style="{StaticResource Small}" Visibility="{Binding DefaultVisibility}"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="10,3" MinWidth="40" Background="#1E2225" BorderBrush="{Binding CapBorder}" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Shortcut}" FontSize="13.5" FontWeight="SemiBold" Foreground="{Binding CapText}" HorizontalAlignment="Center"/>
                </Border>
                <ui:StatusMark Grid.Column="2" Mark="{Binding Mark}" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding MarkTip}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="30,18,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tabs and army choice -->
        <DockPanel Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="TabButtons" Style="{StaticResource SubTab}" Content="Buttons" GroupName="htab" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabKeys" Style="{StaticResource SubTab}" Content="Game keys" GroupName="htab" Checked="Tab_Checked"/>
            </StackPanel>
            <StackPanel x:Name="ArmyBar" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource SegBox}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FUsa" Style="{StaticResource Seg}" Content="USA" GroupName="faction" Height="38" Padding="20,0" Checked="Faction_Checked"/>
                        <RadioButton x:Name="FChina" Style="{StaticResource Seg}" Content="China" GroupName="faction" Height="38" Padding="20,0" Checked="Faction_Checked"/>
                        <RadioButton x:Name="FGla" Style="{StaticResource Seg}" Content="GLA" GroupName="faction" Height="38" Padding="20,0" Checked="Faction_Checked"/>
                    </StackPanel>
                </Border>
                <ComboBox x:Name="General" Width="230" Margin="12,0,0,0" SelectionChanged="General_Changed" ToolTip="Each general has its own buttons"/>
            </StackPanel>
            <Border/>
        </DockPanel>

        <TextBlock x:Name="Loading" Grid.Row="1" Text="Reading the game's buttons…" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- ── Buttons ── -->
        <Grid x:Name="ButtonsView" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MenuCol" Width="250"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition x:Name="SideCol" Width="330"/>
            </Grid.ColumnDefinitions>

            <ui:Chamfer Style="{StaticResource Panel}">
                <ListBox x:Name="Menus" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource Row}" ItemTemplate="{StaticResource MenuTemplate}"
                         SelectionChanged="Menus_SelectionChanged" Padding="0,6,0,10" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <ui:TrackedText Text="{Binding Name}" Style="{StaticResource LblAccent}" Margin="18,14,0,6"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </ui:Chamfer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Control bar preview -->
                <ui:Chamfer Style="{StaticResource Panel}" Padding="22,16,22,16">
                    <StackPanel>
                        <DockPanel>
                            <ui:TrackedText x:Name="MenuTitle" Style="{StaticResource H2}" FontSize="19" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Tag}" Margin="12,0,0,0">
                                <ui:TrackedText Text="In-game layout" FontSize="11" Tracking="0.1" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                            </Border>
                            <Border/>
                        </DockPanel>
                        <Border Margin="0,14,0,0" Padding="8" Background="#0A0B0C" BorderBrush="#30363A" BorderThickness="1" HorizontalAlignment="Left">
                            <UniformGrid x:Name="Slots" Columns="7"/>
                        </Border>
                        <WrapPanel Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                <Border Width="16" Height="16" BorderBrush="{StaticResource Accent}" BorderThickness="2"/>
                                <TextBlock Text="Selected" Style="{StaticResource Small}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                <Grid Width="16" Height="16">
                                    <Rectangle Stroke="{StaticResource Danger}" StrokeThickness="2" StrokeDashArray="2 1.5"/>
                                </Grid>
                                <ui:StatusMark Mark="Danger" Width="12" Height="12" Margin="5,0,0,0"/>
                                <TextBlock Text="Same key twice in this menu" Style="{StaticResource Small}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                <ui:StatusMark Mark="Warn" Width="13" Height="13"/>
                                <TextBlock Text="Also a game key" Style="{StaticResource Small}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                <ui:StatusMark Mark="Changed" Width="12" Height="12"/>
                                <TextBlock Text="Changed from default" Style="{StaticResource Small}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="16" Height="16" Background="#141618" BorderBrush="#262B2E" BorderThickness="1"/>
                                <TextBlock Text="No key" Style="{StaticResource Small}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </ui:Chamfer>

                <!-- Editor -->
                <ui:Chamfer Grid.Row="2" Style="{StaticResource Panel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <Grid Margin="22,20,22,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="IconCol" Width="150"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border x:Name="IconBox" Height="116" Padding="4" Background="#0B0C0D" BorderBrush="#3A4044" BorderThickness="1">
                                    <Image x:Name="BigIcon" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock x:Name="ButtonName" FontSize="18" FontWeight="Bold" FontStretch="Condensed" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <TextBlock x:Name="ButtonWhere" Style="{StaticResource Small}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <DockPanel>
                                    <Border x:Name="KeyCap" Width="64" Height="74" CornerRadius="3" BorderThickness="2" Cursor="Hand" MouseLeftButtonUp="KeyCap_Click"
                                            ToolTip="Click, then press a letter">
                                        <TextBlock x:Name="KeyCapText" FontSize="44" FontWeight="Bold" FontStretch="Condensed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <ui:TrackedText x:Name="ListenTitle" FontSize="17" FontWeight="Bold" Tracking="0.08" Foreground="{StaticResource Steel}"/>
                                        <TextBlock x:Name="ListenHint" Style="{StaticResource Body}" FontSize="13" LineHeight="18" Margin="0,4,0,0"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button x:Name="ChangeBtn" Style="{StaticResource BtnSm}" Margin="0,0,8,8" Content="Change key" ui:Ui.Icon="{StaticResource I.keyboard}" Click="Change_Click"/>
                                            <Button x:Name="ResetBtn" Style="{StaticResource BtnSm}" Margin="0,0,8,8" ui:Ui.Icon="{StaticResource I.undo}" Click="ResetKey_Click"/>
                                            <Button x:Name="ClearBtn" Style="{StaticResource BtnSm}" Content="No key" Margin="0,0,8,8" Click="Clear_Click" ToolTip="Removes the hotkey from this button"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel x:Name="Issues" Margin="0,16,0,0"/>
                                <ui:TrackedText Style="{StaticResource Lbl}" Text="Free keys in this menu" Margin="0,14,0,8"/>
                                <WrapPanel x:Name="Suggestions"/>
                                <ui:TrackedText x:Name="SameLabel" Style="{StaticResource Lbl}" Margin="0,14,0,8"/>
                                <WrapPanel x:Name="SameMenus"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </ui:Chamfer>
            </Grid>

            <!-- Right column -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <ui:Chamfer Style="{StaticResource Panel}">
                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource PanelHead}" Header="Rules check" ui:Ui.Icon="{StaticResource I.shield}" ui:Ui.Subtitle="How the game reads keys"/>
                            <StackPanel x:Name="Rules" Margin="0,4,0,8"/>
                        </StackPanel>
                    </ui:Chamfer>
                    <ui:Chamfer Style="{StaticResource Panel}" Margin="0,16,0,0">
                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource PanelHead}" Header="Who uses a key?" ui:Ui.Icon="{StaticResource I.search}"/>
                            <Border x:Name="Probe" Margin="20,14,20,0" Height="40" Background="{StaticResource InputBg}" BorderBrush="{StaticResource InputLine}" BorderThickness="1"
                                    Focusable="True" Cursor="Hand" MouseLeftButtonUp="Probe_Click" GotKeyboardFocus="Probe_Focus" LostKeyboardFocus="Probe_Focus" KeyDown="Probe_KeyDown"
                                    FocusVisualStyle="{x:Null}">
                                <TextBlock x:Name="ProbeText" Text="Click here, then press a key" Foreground="{StaticResource Text3}" VerticalAlignment="Center" Margin="12,0"/>
                            </Border>
                            <StackPanel x:Name="ProbeResult" Margin="20,10,20,16"/>
                        </StackPanel>
                    </ui:Chamfer>
                    <ui:Chamfer Style="{StaticResource Panel}" Margin="0,16,0,0">
                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource PanelHead}" Header="Layout" ui:Ui.Icon="{StaticResource I.grid}" ui:Ui.Subtitle="Applies to every army"/>
                            <UniformGrid Columns="2" Margin="18,14,18,8">
                                <Button Style="{StaticResource TileBtn}" Content="Classic" ui:Ui.Icon="{StaticResource I.undo}" Margin="0,0,5,0" Click="Classic_Click" ToolTip="The game's own letters, mostly the first letter of the name"/>
                                <Button Style="{StaticResource TileBtn}" Content="Grid" ui:Ui.Icon="{StaticResource I.grid}" Margin="5,0,0,0" Click="Grid_Click" ToolTip="Each key follows its place on the bar: QWERTYU on top, ASDFGHJ below"/>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="20,4,20,18" Text="Nothing is saved until you press Save. Grid puts S and H on buttons; the rules check shows where that also stops units or jumps to your base."/>
                        </StackPanel>
                    </ui:Chamfer>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── Game keys ── -->
        <Grid x:Name="KeysView" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>
            <ui:Chamfer Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBox x:Name="KeySearch" DockPanel.Dock="Top" Margin="18,16,18,8" ui:Ui.Icon="{StaticResource I.search}" ui:Ui.Placeholder="Search commands   Ctrl+K" TextChanged="KeySearch_Changed"/>
                    <ListBox x:Name="KeyList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource Row}" ItemTemplate="{StaticResource GameKeyTemplate}"
                             SelectionChanged="KeyList_SelectionChanged" Padding="0,0,0,10" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <ui:TrackedText Text="{Binding Name}" Style="{StaticResource LblAccent}" Margin="18,14,0,6"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>
            </ui:Chamfer>
            <ui:Chamfer Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel Margin="22,20,22,22">
                    <ui:TrackedText x:Name="KCategory" Style="{StaticResource LblAccent}"/>
                    <TextBlock x:Name="KName" FontSize="22" FontWeight="Bold" FontStretch="Condensed" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Border x:Name="KCap" Margin="0,16,0,0" Height="64" BorderThickness="2" CornerRadius="3" Cursor="Hand" MouseLeftButtonUp="KCap_Click" ToolTip="Click, then press the new combination">
                        <TextBlock x:Name="KCapText" FontSize="24" FontWeight="Bold" FontStretch="Condensed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="KHint" Style="{StaticResource Body}" FontSize="13" LineHeight="18" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="KChange" Style="{StaticResource BtnSm}" Content="Change" ui:Ui.Icon="{StaticResource I.keyboard}" Click="KChange_Click"/>
                        <Button x:Name="KReset" Style="{StaticResource BtnSm}" Margin="8,0,0,0" ui:Ui.Icon="{StaticResource I.undo}" Click="KReset_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="KIssues" Margin="0,16,0,0"/>
                </StackPanel>
            </ui:Chamfer>
        </Grid>
    </Grid>
</UserControl>
