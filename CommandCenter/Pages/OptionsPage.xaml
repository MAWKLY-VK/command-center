<Page
    x:Class="CommandCenter.Pages.OptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:CommandCenter.Services"
    Background="#01031A">

    <Page.Resources>
        <!-- Nav tab RadioButton style -->
        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="16,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="RootBorder"
                            Background="#01031A"
                            BorderThickness="3,0,0,0"
                            BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#040C52"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#2980FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#020830"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Back button style -->
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#01031A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="4,8,4,4"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#2980FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextBlock.Foreground="{TemplateBinding Foreground}"
                                TextBlock.FontSize="{TemplateBinding FontSize}"
                                TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#040C52"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#5BA4FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#020630"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Numeric TextBox style -->
        <Style x:Key="NumericBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#404060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#2980FF"/>
        </Style>

        <!-- Section header style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Field label style -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="220"/>
        </Style>
        <!-- Diagnostics button style -->
        <Style x:Key="DiagButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#01031A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#2980FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#040C52"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#5BA4FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#020630"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="BorderBrush" Value="#404060"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="165"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left sidebar -->
        <Grid Grid.Column="0" Background="#00020F">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="0,8,0,0">
                <RadioButton x:Name="rbCamera" Content="{l:T CAMERA}" GroupName="OptionsTabs"
                             Style="{StaticResource NavTabStyle}" IsChecked="True"
                             Checked="Tab_Checked"/>
                <RadioButton x:Name="rbChat" Content="{l:T CHAT}" GroupName="OptionsTabs"
                             Style="{StaticResource NavTabStyle}" Checked="Tab_Checked"/>
                <RadioButton x:Name="rbInput" Content="{l:T INPUT}" GroupName="OptionsTabs"
                             Style="{StaticResource NavTabStyle}" Checked="Tab_Checked"/>
                <RadioButton x:Name="rbGraphics" Content="{l:T GRAPHICS}" GroupName="OptionsTabs"
                             Style="{StaticResource NavTabStyle}" Checked="Tab_Checked"/>
                <RadioButton x:Name="rbSocial" Content="{l:T SOCIAL}" GroupName="OptionsTabs"
                             Style="{StaticResource NavTabStyle}" Checked="Tab_Checked"/>
                <RadioButton x:Name="rbNetwork" Content="{l:T NETWORK}" GroupName="OptionsTabs"
                             Style="{StaticResource NavTabStyle}" Checked="Tab_Checked"/>
                <RadioButton x:Name="rbDataPacks" Content="{l:T DATA PACKS}" GroupName="OptionsTabs"
                             Style="{StaticResource NavTabStyle}" Checked="Tab_Checked"/>
                <RadioButton x:Name="rbPlugins" Content="{l:T PLUGINS}" GroupName="OptionsTabs"
                             Style="{StaticResource NavTabStyle}" Checked="Tab_Checked"/>
                <RadioButton x:Name="rbLauncher" Content="{l:T LAUNCHER}" GroupName="OptionsTabs"
                             Style="{StaticResource NavTabStyle}" Checked="Tab_Checked"/>
            </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="1" x:Name="btnBack"
                    Content="{l:T SAVE &amp; GO BACK}"
                    Style="{StaticResource BackButtonStyle}"
                    Click="BtnBack_Click"/>
        </Grid>

        <!-- Content area -->
        <ScrollViewer Grid.Column="1" Padding="24,20,24,20" VerticalScrollBarVisibility="Auto"
                      Background="#01031A">

            <!-- All panels overlap in the same cell — only one visible at a time -->
            <Grid>
                <!-- CAMERA -->
                <StackPanel x:Name="PanelCamera" Visibility="Visible">
                    <TextBlock Text="{l:T CAMERA}" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:T Maximum Camera Height *}"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtMaxCameraHeight"
                                 Style="{StaticResource NumericBoxStyle}" Text="310"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{l:T * Only applies when you are the lobby host}"
                                   Foreground="#888888" FontSize="11"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:T Minimum Camera Height}"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtMinCameraHeight"
                                 Style="{StaticResource NumericBoxStyle}" Text="210"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:T Camera Movement Speed (%)}"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtCameraMovementSpeed"
                                 Style="{StaticResource NumericBoxStyle}" Text="100"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>
                    </Grid>
                </StackPanel>

                <!-- CHAT -->
                <StackPanel x:Name="PanelChat" Visibility="Collapsed">
                    <TextBlock Text="{l:T CHAT}" Style="{StaticResource SectionHeaderStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{l:T Fade Out Duration (Seconds)}"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="txtChatDuration"
                                 Style="{StaticResource NumericBoxStyle}" Text="30"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>
                    </StackPanel>
                </StackPanel>

                <!-- INPUT -->
                <StackPanel x:Name="PanelInput" Visibility="Collapsed">
                    <TextBlock Text="{l:T INPUT}" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>
                        <CheckBox Grid.Row="0" Grid.Column="0" x:Name="chkCursorLockWindowed"
                                  Content="{l:T Cursor Lock (Windowed)}"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" x:Name="chkCursorLockFullscreen"
                                  Content="{l:T Cursor Lock (Fullscreen)}"/>
                        <CheckBox Grid.Row="1" Grid.Column="0" x:Name="chkEdgeScrollingWindowed"
                                  Content="{l:T Edge Scrolling (Windowed)}"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" x:Name="chkEdgeScrollingFullscreen"
                                  Content="{l:T Edge Scrolling (Fullscreen)}"/>
                    </Grid>
                </StackPanel>

                <!-- GRAPHICS -->
                <StackPanel x:Name="PanelGraphics" Visibility="Collapsed" Margin="0,0,0,0">
                    <TextBlock Text="{l:T GRAPHICS}" Style="{StaticResource SectionHeaderStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <CheckBox x:Name="chkLimitFramerate" Content="{l:T Limit Framerate}"
                                  Checked="ChkLimitFramerate_Changed"
                                  Unchecked="ChkLimitFramerate_Changed"
                                  VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBox x:Name="txtFPSLimit"
                                 Style="{StaticResource NumericBoxStyle}" Text="60"
                                 IsEnabled="False"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>
                        <TextBlock Text="FPS" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="chkStatsOverlay" Content="{l:T Show Statistics Overlay}"/>
                    <CheckBox x:Name="chkWindowed" Content="{l:T Windowed}" Margin="0,8,0,4"
                              Checked="ChkWindowed_Changed"
                              Unchecked="ChkWindowed_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{l:T Windowed Resolution}" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="cmbWindowedResolution" Width="160" IsEnabled="False"
                                  Background="#1E1E2E" Foreground="White" BorderBrush="#404060"/>
                    </StackPanel>
                </StackPanel>

                <!-- SOCIAL -->
                <StackPanel x:Name="PanelSocial" Visibility="Collapsed">
                    <TextBlock Text="{l:T NOTIFICATIONS}" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:T In-Game}"
                                   Foreground="#888888" FontSize="11" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{l:T In Menus}"
                                   Foreground="#888888" FontSize="11" Margin="0,0,0,6"/>

                        <CheckBox Grid.Row="1" Grid.Column="0" x:Name="chkFriendOnlineInGame"
                                  Content="{l:T Friend Comes Online (In-Game)}"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" x:Name="chkFriendOnlineInMenus"
                                  Content="{l:T Friend Comes Online (In Menus)}"/>
                        <CheckBox Grid.Row="2" Grid.Column="0" x:Name="chkFriendOfflineInGame"
                                  Content="{l:T Friend Goes Offline (In-Game)}"/>
                        <CheckBox Grid.Row="2" Grid.Column="1" x:Name="chkFriendOfflineInMenus"
                                  Content="{l:T Friend Goes Offline (In Menus)}"/>
                        <CheckBox Grid.Row="3" Grid.Column="0" x:Name="chkFriendRequestInGame"
                                  Content="{l:T Incoming Friend Request (In-Game)}"/>
                        <CheckBox Grid.Row="3" Grid.Column="1" x:Name="chkFriendRequestInMenus"
                                  Content="{l:T Incoming Friend Request (In Menus)}"/>
                        <CheckBox Grid.Row="4" Grid.Column="0" x:Name="chkFriendAcceptedInGame"
                                  Content="{l:T Outgoing Request Accepted (In-Game)}"/>
                        <CheckBox Grid.Row="4" Grid.Column="1" x:Name="chkFriendAcceptedInMenus"
                                  Content="{l:T Outgoing Request Accepted (In Menus)}"/>
                    </Grid>
                </StackPanel>

                <!-- NETWORK -->
                <StackPanel x:Name="PanelNetwork" Visibility="Collapsed">
                    <TextBlock Text="{l:T NETWORK}" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock
                        Text="{l:T ⚠ These are advanced options that you should not change unless you know what you are doing.}"
                        Foreground="#FF6060" FontWeight="Bold" FontSize="12"
                        TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{l:T HTTP Version}" Style="{StaticResource FieldLabelStyle}" MinWidth="100"/>
                        <ComboBox x:Name="cmbHTTPVersion" Width="200" SelectedIndex="0"
                                  Background="#1E1E2E" Foreground="White" BorderBrush="#404060">
                            <ComboBoxItem Content="{l:T Automatic}"/>
                            <ComboBoxItem Content="1.0"/>
                            <ComboBoxItem Content="1.1"/>
                            <ComboBoxItem Content="2.0"/>
                            <ComboBoxItem Content="3.0"/>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="chkAlternativeEndpoint" Content="{l:T Use Alternative Endpoints}"/>

                    <!-- ── DIAGNOSTICS ──────────────────────────────────────── -->
                    <Rectangle Height="1" Fill="#252550" Margin="0,16,0,16"/>
                    <TextBlock Text="{l:T DIAGNOSTICS}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="btnRunDiagnostics"
                                Content="{l:T ▶  RUN DIAGNOSTICS}"
                                Style="{StaticResource DiagButtonStyle}"
                                Margin="0,0,10,0"
                                Click="BtnRunDiagnostics_Click"/>
                        <Button x:Name="btnCopyDiag"
                                Content="{l:T ⎘  COPY}"
                                Style="{StaticResource DiagButtonStyle}"
                                IsEnabled="False"
                                Click="BtnCopyDiag_Click"/>
                    </StackPanel>

                    <!-- Results panel — hidden until first run -->
                    <Border x:Name="panelDiagResults" Visibility="Collapsed"
                            Background="#07091C" BorderBrush="#2A2A55" BorderThickness="1"
                            Padding="14,12,14,14" Margin="0,0,0,10">
                        <StackPanel>

                            <!-- Internet baseline -->
                            <TextBlock Text="{l:T INTERNET}" Foreground="#404070" FontSize="10"
                                       FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotGeo" Width="8" Height="8" Fill="#404070"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="{l:T Your Location}" Foreground="#8888AA"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valGeo" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotCF" Width="8" Height="8" Fill="#404070"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="Cloudflare" Foreground="#8888AA"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valCF" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotDl" Width="8" Height="8" Fill="#404070"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="{l:T Download Speed}" Foreground="#8888AA"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valDl" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <Ellipse x:Name="dotUl" Width="8" Height="8" Fill="#404070"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="{l:T Upload Speed}" Foreground="#8888AA"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valUl" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Game server -->
                            <TextBlock Text="{l:T GAME SERVER}" Foreground="#404070" FontSize="10"
                                       FontWeight="Bold" FontFamily="Segoe UI" Margin="0,10,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotDns" Width="8" Height="8" Fill="#404070"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="{l:T DNS Resolution}" Foreground="#8888AA"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valDns" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotPing" Width="8" Height="8" Fill="#404070"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="{l:T Server Ping  (ICMP)}" Foreground="#8888AA"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valPing" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotProto" Width="8" Height="8" Fill="#404070"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="{l:T Protocol}" Foreground="#8888AA"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valProto" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotHttp" Width="8" Height="8" Fill="#404070"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="{l:T HTTP Latency}" Foreground="#8888AA"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valHttp" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <Ellipse x:Name="dotServer" Width="8" Height="8" Fill="#404070"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="{l:T Server Status}" Foreground="#8888AA"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valServer" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Connectivity -->
                            <TextBlock Text="{l:T CONNECTIVITY}" Foreground="#404070" FontSize="10"
                                       FontWeight="Bold" FontFamily="Segoe UI" Margin="0,10,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotCdn" Width="8" Height="8" Fill="#404070"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="CDN  cdn.playgenerals.online" Foreground="#8888AA"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valCdn" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotStun" Width="8" Height="8" Fill="#404070"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="STUN  stun.playgenerals.online" Foreground="#8888AA"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valStun" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotTurn" Width="8" Height="8" Fill="#404070"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="TURN  turn.playgenerals.online" Foreground="#8888AA"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valTurn" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <Ellipse x:Name="dotNat" Width="8" Height="8" Fill="#404070"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="{l:T NAT Type}" Foreground="#8888AA"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valNat" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- Run log — last 10 results -->
                    <TextBlock Text="{l:T LOG}" Foreground="#404070" FontSize="10"
                               FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                    <Border Background="#07091C" BorderBrush="#2A2A55" BorderThickness="1"
                            Padding="10,8" MaxHeight="130">
                        <ScrollViewer x:Name="diagLogScroller" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="diagLog"/>
                        </ScrollViewer>
                    </Border>

                </StackPanel>

                <!-- DATA PACKS -->
                <StackPanel x:Name="PanelDataPacks" Visibility="Collapsed">
                    <TextBlock Text="{l:T DATA PACKS}" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="{l:T We recommend enabling this if you are playing the unmodified game, or DISABLING it if you are playing with a modification.}"
                               Foreground="#E0A030" FontSize="12" TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <CheckBox x:Name="chkUseCommunityDataPatch" Content="{l:T Use Community Data Patch}"/>
                </StackPanel>

                <!-- PLUGINS -->
                <StackPanel x:Name="PanelPlugins" Visibility="Collapsed">
                    <TextBlock Text="{l:T PLUGINS}" Style="{StaticResource SectionHeaderStyle}"/>
                    
                    <!-- ANTICHEAT -->
                    <TextBlock Text="{l:T ANTICHEAT}" Foreground="#8888AA" FontSize="12" FontWeight="Bold" 
                               Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="{l:T Plugin}" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="cmbAnticheatPlugin" Width="250"
                                  Background="#1E1E2E" Foreground="White" BorderBrush="#404060"
                                  SelectionChanged="CmbAnticheatPlugin_SelectionChanged"/>
                    </StackPanel>
                    
                    <!-- Configuration Details -->
                    <TextBlock Text="{l:T CONFIGURATION}" Foreground="#8888AA" FontSize="12" FontWeight="Bold" 
                               Margin="0,0,0,8"/>
                    <Border Background="#07091C" BorderBrush="#2A2A55" BorderThickness="1"
                            Padding="14,12" MaxHeight="400" Margin="0,0,0,0" FlowDirection="LeftToRight">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="configDetailsPanel">
                                <TextBlock Text="{l:T (No plugin selected)}" Foreground="#A0A0C0" FontSize="11"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- LAUNCHER: Command Center's own preferences -->
                <StackPanel x:Name="PanelLauncher" Visibility="Collapsed">
                    <TextBlock Text="{l:T LAUNCHER}" Style="{StaticResource SectionHeaderStyle}"/>

                    <TextBlock Text="{l:T LANGUAGE}" Foreground="#8888AA" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{l:T Interface language}" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="cmbLanguage" Width="250" SelectionChanged="CmbLanguage_SelectionChanged"/>
                    </StackPanel>
                    <TextBlock Text="{l:T Command Center restarts to switch the language.}" Foreground="#888888" FontSize="11" Margin="0,0,0,20"/>

                    <TextBlock Text="{l:T MAP LIBRARY}" Foreground="#8888AA" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{l:T Library source}" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="txtMapLibrary" Style="{StaticResource TextBoxStyle}" Width="250" Height="32"/>
                        <Button Content="{l:T DEFAULT}" Style="{StaticResource DiagButtonStyle}" Margin="8,0,0,0" Click="BtnMapLibraryDefault_Click"/>
                    </StackPanel>
                    <TextBlock Text="{l:T Empty uses the online library. You can also enter a web address or a folder that holds catalog.json.}"
                               Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <TextBlock Text="{l:T UPDATES}" Foreground="#8888AA" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock x:Name="txtVersion" Style="{StaticResource FieldLabelStyle}"/>
                        <Button x:Name="btnCheckUpdates" Content="{l:T CHECK FOR UPDATES}" Style="{StaticResource DiagButtonStyle}" Click="BtnCheckUpdates_Click"/>
                        <TextBlock x:Name="txtUpdateStatus" Foreground="#8888AA" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="{l:T ABOUT}" Foreground="#8888AA" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Foreground="#A0A0C0" FontSize="12" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                               Text="{l:T Command Center is free software under the GNU General Public License, version 3. It is based on the Generals Online Launcher by the GeneralsOnline Development Team, also under GPL-3.0. It is not made by or affiliated with Generals Online or Electronic Arts.}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
