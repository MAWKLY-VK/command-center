<UserControl x:Class="CommandCenter.Pages.MapsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CommandCenter.Controls"
             AllowDrop="True" Drop="Page_Drop" DragOver="Page_DragOver">
    <UserControl.Resources>
        <!-- Map card: picture with the player count, then name and tags below the picture -->
        <DataTemplate x:Key="CardTemplate">
            <Grid Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,14,14">
                <ui:Chamfer x:Name="plate" Cut="10" Background="#E6141618" BorderBrush="{Binding Edge}" BorderThickness="1.5">
                    <StackPanel>
                        <Grid Height="{Binding CardImageHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                            <ui:Icon Data="{StaticResource I.map}" Width="40" Height="40" Foreground="#30363A" Visibility="{Binding NoPreview}"/>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="6,2" Background="#D9000000">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Icon Data="{StaticResource I.users}" Width="13" Height="13" Foreground="{StaticResource Accent}"/>
                                    <TextBlock Text="{Binding PlayersText}" FontSize="12.5" FontWeight="SemiBold" Margin="5,0,0,0" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" Visibility="{Binding CheckVisibility}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                      ToolTip="Select for installing several maps at once"/>
                        </Grid>
                        <StackPanel Margin="12,9,12,11">
                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" FontStretch="Condensed" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Style="{StaticResource Tag}" Visibility="{Binding InstalledVisibility}" BorderBrush="{StaticResource OkLine}" Background="{StaticResource OkSoft}" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:StatusMark Mark="Ok" Width="10" Height="10" Margin="0,0,5,0"/>
                                        <ui:TrackedText Text="Installed" FontSize="10.5" Tracking="0.08" Foreground="{StaticResource Ok}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource Small}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ui:Chamfer>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="30,18,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="TabLibrary" Style="{StaticResource SubTab}" Content="Library" GroupName="mtab" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabInstalled" Style="{StaticResource SubTab}" Content="Installed" GroupName="mtab" Checked="Tab_Checked"/>
                <Border Style="{StaticResource SegBox}" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="PAll" Style="{StaticResource Seg}" Content="All" GroupName="players" IsChecked="True" Checked="Filter_Changed"/>
                        <RadioButton x:Name="P2" Style="{StaticResource Seg}" Content="2" GroupName="players" Checked="Filter_Changed" ToolTip="Two players"/>
                        <RadioButton x:Name="P4" Style="{StaticResource Seg}" Content="3–4" GroupName="players" Checked="Filter_Changed"/>
                        <RadioButton x:Name="P6" Style="{StaticResource Seg}" Content="5–6" GroupName="players" Checked="Filter_Changed"/>
                        <RadioButton x:Name="P8" Style="{StaticResource Seg}" Content="7–8" GroupName="players" Checked="Filter_Changed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox x:Name="Search" Width="260" ui:Ui.Icon="{StaticResource I.search}" ui:Ui.Placeholder="Search maps   Ctrl+K" TextChanged="Search_Changed"/>
                <ComboBox x:Name="Sort" Width="150" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Name A–Z"/>
                    <ComboBoxItem Content="Most players"/>
                    <ComboBoxItem Content="Newest"/>
                    <ComboBoxItem Content="Largest"/>
                </ComboBox>
            </StackPanel>
            <Border/>
        </DockPanel>

        <!-- Cards -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False" ScrollChanged="Scroller_ScrollChanged" SizeChanged="Scroller_SizeChanged">
                <StackPanel>
                    <ItemsControl x:Name="Cards" ItemTemplate="{StaticResource CardTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <EventSetter Event="MouseLeftButtonUp" Handler="Card_Click"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                    <TextBlock x:Name="Counter" Style="{StaticResource Small}" HorizontalAlignment="Center" Margin="0,6,0,10"/>
                </StackPanel>
            </ScrollViewer>
            <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" MaxWidth="460">
                <ui:Icon Data="{StaticResource I.map}" Width="44" Height="44" Foreground="#3A4044"/>
                <TextBlock x:Name="EmptyTitle" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Body}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
                <Button x:Name="ChooseLibrary" Content="Choose library folder" ui:Ui.Icon="{StaticResource I.folder}" HorizontalAlignment="Center" Margin="0,16,0,0" Click="ChooseLibrary_Click"/>
            </StackPanel>
        </Grid>

        <!-- Details -->
        <ui:Chamfer Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}">
            <Grid>
                <ScrollViewer x:Name="Details" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="20,20,20,20">
                        <Border Padding="5" Background="#0B0C0D" BorderBrush="#3A4044" BorderThickness="1">
                            <Grid x:Name="BigPreview" Height="300">
                                <Image x:Name="BigImage" Stretch="Fill"/>
                                <Canvas x:Name="StartLayer"/>
                            </Grid>
                        </Border>
                        <ui:TrackedText x:Name="DKicker" Style="{StaticResource Lbl}" Margin="0,16,0,0"/>
                        <TextBlock x:Name="DName" FontSize="24" FontWeight="Bold" FontStretch="Condensed" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <ui:Chamfer Style="{StaticResource Tile}" Padding="12,9" Margin="0,0,5,0">
                                <StackPanel>
                                    <ui:TrackedText Style="{StaticResource Lbl}" Text="Players"/>
                                    <TextBlock x:Name="DPlayers" FontSize="17" FontWeight="SemiBold" FontStretch="Condensed" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ui:Chamfer>
                            <ui:Chamfer Style="{StaticResource Tile}" Padding="12,9" Margin="5,0,0,0">
                                <StackPanel>
                                    <ui:TrackedText Style="{StaticResource Lbl}" Text="Size"/>
                                    <TextBlock x:Name="DSize" FontSize="17" FontWeight="SemiBold" FontStretch="Condensed" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ui:Chamfer>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <ui:StatusMark Mark="Ok" Width="13" Height="13"/>
                            <TextBlock Text="Only map files are copied; nothing changes unit rules" Style="{StaticResource Small}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button x:Name="InstallBtn" Style="{StaticResource BtnLg}" ui:Ui.Variant="Primary" ui:Ui.Icon="{StaticResource I.download}" Content="Install" Margin="0,16,0,0" Click="Install_Click"/>
                        <Button x:Name="RemoveBtn" Style="{StaticResource BtnLg}" ui:Ui.Variant="Danger" ui:Ui.Icon="{StaticResource I.trash}" Content="Remove" Margin="0,16,0,0" Click="Remove_Click" ToolTip="Moves the map out of the game; Undo brings it back"/>
                        <Button Content="Show in folder" ui:Ui.Icon="{StaticResource I.folder}" Margin="0,10,0,0" Click="ShowFolder_Click"/>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock x:Name="NoSelection" Text="Select a map" Foreground="{StaticResource Text3}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </ui:Chamfer>
    </Grid>
</UserControl>
