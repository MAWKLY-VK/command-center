<UserControl x:Class="CommandCenter.Pages.AddonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CommandCenter.Controls">
    <UserControl.Resources>
        <!-- A choice card: radio ring, thumbnail of the bar, title, text and tags below -->
        <Style x:Key="BarChoice" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="GroupName" Value="bar"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ui:Chamfer x:Name="plate" Cut="10" Background="#B3101214" BorderBrush="{StaticResource Line}" BorderThickness="1.5" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                                        <Ellipse x:Name="ring" Stroke="#4A5155" StrokeThickness="1.6" Fill="{StaticResource InputBg}"/>
                                        <Ellipse x:Name="dot" Width="9" Height="9" Fill="{StaticResource Accent}" Visibility="Collapsed"/>
                                    </Grid>
                                    <Border Grid.Column="1" Width="150" Height="62" Margin="14,0,16,0" ClipToBounds="True" BorderBrush="#30363A" BorderThickness="1" Background="Black">
                                        <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill" VerticalAlignment="Bottom"/>
                                    </Border>
                                    <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
                                </Grid>
                            </ui:Chamfer>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="plate" Property="BorderBrush" Value="#4A5155"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="plate" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="plate" Property="Background" Value="#1FF0A51B"/>
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Accent}"/>
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="30,24,30,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="460"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <ui:Chamfer Style="{StaticResource Panel}">
                    <StackPanel>
                        <HeaderedContentControl Style="{StaticResource PanelHead}" Header="Control bar" ui:Ui.Icon="{StaticResource I.cube}" ui:Ui.Subtitle="Pick one; it replaces the bar at the bottom of the screen"/>
                        <StackPanel Margin="18,16,18,6">
                            <RadioButton x:Name="ROriginal" Style="{StaticResource BarChoice}" Checked="Choice_Checked">
                                <StackPanel>
                                    <TextBlock Text="Original" FontSize="16" FontWeight="SemiBold" FontStretch="Condensed"/>
                                    <TextBlock Text="The game's own control bar" Style="{StaticResource Small}" Margin="0,3,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Style="{StaticResource Tag}"><TextBlock Text="Game default" FontSize="11.5"/></Border>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RPro" Style="{StaticResource BarChoice}" Checked="Choice_Checked">
                                <StackPanel>
                                    <TextBlock Text="Control Bar Pro" FontSize="16" FontWeight="SemiBold" FontStretch="Condensed"/>
                                    <TextBlock Text="Larger, cleaner bar by TheSuperHackers · v1.2" Style="{StaticResource Small}" Margin="0,3,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Style="{StaticResource Tag}" BorderBrush="{StaticResource AccentLine}" Background="{StaticResource AccentSoft}" Margin="0,0,6,0">
                                            <TextBlock Text="Recommended" FontSize="11.5" Foreground="{StaticResource AccentHi}"/>
                                        </Border>
                                        <ComboBox x:Name="Resolution" Width="130" Height="26" FontSize="12.5" SelectionChanged="Resolution_Changed" ToolTip="Pick the size that matches your game resolution"/>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RObserver" Style="{StaticResource BarChoice}" Checked="Choice_Checked">
                                <StackPanel>
                                    <TextBlock Text="Observer bar" FontSize="16" FontWeight="SemiBold" FontStretch="Condensed"/>
                                    <TextBlock Text="Player money, power and armies while watching · v1.5" Style="{StaticResource Small}" Margin="0,3,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Style="{StaticResource Tag}" Margin="0,0,6,0"><TextBlock Text="For casters" FontSize="11.5"/></Border>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <Rectangle Style="{StaticResource Rule}"/>
                        <DockPanel Margin="20,14,20,18">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnSm}" Content="GenTool site" ui:Ui.Icon="{StaticResource I.external}" Click="Hd_Click" VerticalAlignment="Center"/>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="HD textures" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,3,0,0" Text="Sharper art for any bar. Only offered on the GenTool website, so it is not installed from here."/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </ui:Chamfer>

                <ui:Chamfer Style="{StaticResource Panel}" Margin="0,18,0,0">
                    <StackPanel>
                        <HeaderedContentControl Style="{StaticResource PanelHead}" Header="Safety" ui:Ui.Icon="{StaticResource I.shield}"/>
                        <StackPanel x:Name="Safety" Margin="20,10,20,16"/>
                    </StackPanel>
                </ui:Chamfer>
            </StackPanel>

            <!-- Compare -->
            <ui:Chamfer Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel>
                    <HeaderedContentControl Style="{StaticResource PanelHead}" Header="Compare" ui:Ui.Icon="{StaticResource I.eye}" x:Name="CompareHead" ui:Ui.Subtitle="Drag across the picture"/>
                    <Grid x:Name="CompareBox" Margin="18,16,18,10" Height="330" ClipToBounds="True" Cursor="SizeWE" Background="Black"
                          MouseLeftButtonDown="Compare_Down" MouseMove="Compare_Move" MouseLeftButtonUp="Compare_Up" SizeChanged="Compare_SizeChanged">
                        <Image x:Name="Before" Stretch="UniformToFill" VerticalAlignment="Bottom"/>
                        <Image x:Name="After" Stretch="UniformToFill" VerticalAlignment="Bottom"/>
                        <Rectangle x:Name="Divider" Width="2" HorizontalAlignment="Left" Fill="{StaticResource AccentHi}"/>
                        <Border x:Name="Handle" Width="34" Height="34" CornerRadius="17" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource GoldFill}" BorderBrush="#1D1405" BorderThickness="1.5">
                            <ui:Icon Data="M9 6 3 12l6 6M15 6l6 6-6 6" Width="18" Height="18" Foreground="#1D1405" Stroke="2.2"/>
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,3" Background="#CC000000">
                            <TextBlock x:Name="BeforeLabel" Text="Original" FontSize="12.5" Foreground="White"/>
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8,3" Background="#CC000000">
                            <TextBlock x:Name="AfterLabel" FontSize="12.5" Foreground="{StaticResource AccentHi}"/>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="CompareNote" Style="{StaticResource Small}" Margin="20,0,20,18" TextWrapping="Wrap"/>
                </StackPanel>
            </ui:Chamfer>
        </Grid>
    </ScrollViewer>
</UserControl>
