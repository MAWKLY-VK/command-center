<UserControl x:Class="CommandCenter.Pages.ReplaysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CommandCenter.Controls">
    <UserControl.Resources>
        <Style x:Key="StarToggle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Foreground" Value="#5A6266"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="30" Height="30">
                            <ui:Icon x:Name="star" Data="{StaticResource I.star}" Width="18" Height="18"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text2}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter TargetName="star" Property="Filled" Value="True"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PlayerChip">
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0" ToolTip="{Binding Tip}">
                <Rectangle Width="8" Height="8" Fill="{Binding Brush}" Margin="1,0,7,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                </Rectangle>
                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" MaxWidth="96" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RowTemplate">
            <Grid Height="62" Margin="16,0,10,0" ToolTip="{Binding FileName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" BorderBrush="#3A4044" BorderThickness="1" Background="#0B0C0D">
                    <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Map}" FontSize="15" FontWeight="SemiBold" FontStretch="Condensed" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Small}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding Shown}" ItemTemplate="{StaticResource PlayerChip}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Border Style="{StaticResource Tag}" Visibility="{Binding MoreVisibility}" ToolTip="{Binding AllPlayers}">
                        <TextBlock Text="{Binding More}" FontSize="12"/>
                    </Border>
                </StackPanel>
                <Border Grid.Column="3" Style="{StaticResource Tag}">
                    <ui:TrackedText Text="{Binding Mode}" FontSize="11.5" Tracking="0.08" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="4" Text="{Binding Length}" FontSize="15" FontWeight="SemiBold" FontStretch="Condensed" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="{Binding Size}" Style="{StaticResource Small}" VerticalAlignment="Center"/>
                <ToggleButton Grid.Column="6" Style="{StaticResource StarToggle}" IsChecked="{Binding Starred, Mode=TwoWay}" ToolTip="Star this replay" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="30,18,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Tabs, search and the archive switch -->
        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="TabAll" Style="{StaticResource SubTab}" Content="All" GroupName="rtab" IsChecked="True" Checked="Filter_Changed"/>
                <RadioButton x:Name="TabStarred" Style="{StaticResource SubTab}" Content="Starred" GroupName="rtab" Checked="Filter_Changed"/>
                <RadioButton x:Name="TabArchived" Style="{StaticResource SubTab}" Content="Archived" GroupName="rtab" Checked="Filter_Changed"/>
                <TextBox x:Name="Search" Width="300" Margin="10,0,0,0" ui:Ui.Icon="{StaticResource I.search}" ui:Ui.Placeholder="Search map or player   Ctrl+K" TextChanged="Search_Changed"/>
            </StackPanel>
            <ui:Chamfer DockPanel.Dock="Right" Style="{StaticResource Tile}" Padding="14,8" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="Archive" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Archive_Click"
                              ToolTip="Sets ArchiveReplays in Options.ini; the game then copies every match to ArchivedReplays"/>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Archive every match" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="The game's own ArchiveReplays option" Style="{StaticResource Small}"/>
                    </StackPanel>
                </StackPanel>
            </ui:Chamfer>
            <Border/>
        </DockPanel>

        <!-- List -->
        <ui:Chamfer Grid.Row="1" Style="{StaticResource Panel}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="40" Margin="16,6,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <ui:TrackedText Grid.Column="1" Style="{StaticResource Lbl}" Text="Map" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <ui:TrackedText Grid.Column="2" Style="{StaticResource Lbl}" Text="Players" VerticalAlignment="Center"/>
                    <ui:TrackedText Grid.Column="3" Style="{StaticResource Lbl}" Text="Mode" VerticalAlignment="Center"/>
                    <ui:TrackedText Grid.Column="4" Style="{StaticResource Lbl}" Text="Length" VerticalAlignment="Center"/>
                    <ui:TrackedText Grid.Column="5" Style="{StaticResource Lbl}" Text="Size" VerticalAlignment="Center"/>
                </Grid>
                <Rectangle DockPanel.Dock="Top" Style="{StaticResource Rule}"/>
                <Grid>
                    <ListBox x:Name="List" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource Row}" ItemTemplate="{StaticResource RowTemplate}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" Padding="0,0,0,12"
                             SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_DoubleClick" KeyDown="List_KeyDown">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <ui:TrackedText Text="{Binding Name}" Style="{StaticResource LblAccent}" Margin="18,16,0,8"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                    <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <ui:Icon Data="{StaticResource I.replay}" Width="40" Height="40" Foreground="#3A4044"/>
                        <TextBlock x:Name="EmptyText" Text="No replays yet" FontSize="16" Foreground="{StaticResource Text2}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </ui:Chamfer>

        <!-- Details -->
        <ui:Chamfer Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}">
            <Grid>
                <ScrollViewer x:Name="Details" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <Grid Height="170">
                            <Image x:Name="Banner" Stretch="UniformToFill" VerticalAlignment="Center" Opacity="0.75"/>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#33111315" Offset="0"/>
                                        <GradientStop Color="#F2111315" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,14">
                                <ui:TrackedText x:Name="When" Style="{StaticResource Lbl}" Foreground="{StaticResource Text2}"/>
                                <TextBlock x:Name="DetailTitle" FontSize="26" FontWeight="Bold" FontStretch="Condensed" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                <TextBox x:Name="RenameBox" Visibility="Collapsed" Margin="0,4,0,0" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="Teams" Margin="20,12,20,0"/>
                        <UniformGrid Columns="2" Margin="20,14,20,0">
                            <ui:Chamfer Style="{StaticResource Tile}" Padding="12,9" Margin="0,0,5,10">
                                <StackPanel>
                                    <ui:TrackedText Style="{StaticResource Lbl}" Text="Length"/>
                                    <TextBlock x:Name="DLength" FontSize="17" FontWeight="SemiBold" FontStretch="Condensed" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ui:Chamfer>
                            <ui:Chamfer Style="{StaticResource Tile}" Padding="12,9" Margin="5,0,0,10">
                                <StackPanel>
                                    <ui:TrackedText Style="{StaticResource Lbl}" Text="Game version"/>
                                    <TextBlock x:Name="DVersion" FontSize="17" FontWeight="SemiBold" FontStretch="Condensed" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </ui:Chamfer>
                            <ui:Chamfer Style="{StaticResource Tile}" Padding="12,9" Margin="0,0,5,0">
                                <StackPanel>
                                    <ui:TrackedText Style="{StaticResource Lbl}" Text="Starting cash"/>
                                    <TextBlock x:Name="DCash" FontSize="17" FontWeight="SemiBold" FontStretch="Condensed" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ui:Chamfer>
                            <ui:Chamfer Style="{StaticResource Tile}" Padding="12,9" Margin="5,0,0,0">
                                <StackPanel>
                                    <ui:TrackedText Style="{StaticResource Lbl}" Text="Superweapons"/>
                                    <TextBlock x:Name="DSuper" FontSize="17" FontWeight="SemiBold" FontStretch="Condensed" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ui:Chamfer>
                        </UniformGrid>
                        <StackPanel x:Name="Flags" Margin="20,10,20,0"/>
                        <Border Margin="20,14,20,0" Padding="12,9" BorderBrush="{StaticResource LineHi}" BorderThickness="1" Background="#80090A0B">
                            <TextBlock x:Name="DFile" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Text2}" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Button x:Name="WatchBtn" Style="{StaticResource BtnLg}" ui:Ui.Variant="Primary" ui:Ui.Icon="{StaticResource I.play}" ui:Ui.IconFilled="True"
                                Content="Watch replay" Margin="20,16,20,0" Click="Watch_Click" ToolTip="Starts the game in replay mode (Enter)"/>
                        <Button x:Name="KeepBtn" Content="Keep this match" ui:Ui.Icon="{StaticResource I.download}" Margin="20,10,20,0" Click="Keep_Click"
                                ToolTip="The game overwrites 00000000.rep after every match; this saves a copy with a readable name"/>
                        <UniformGrid Columns="2" Margin="20,10,20,20">
                            <Button Content="Rename" ui:Ui.Icon="{StaticResource I.edit}" Margin="0,0,5,10" Click="Rename_Click" ToolTip="F2"/>
                            <Button Content="Show file" ui:Ui.Icon="{StaticResource I.folder}" Margin="5,0,0,10" Click="Show_Click"/>
                            <Button Content="Copy file" ui:Ui.Icon="{StaticResource I.copy}" Margin="0,0,5,0" Click="Copy_Click" ToolTip="Copies the replay so you can paste it into Discord"/>
                            <Button x:Name="DeleteBtn" Content="Delete" ui:Ui.Variant="Danger" ui:Ui.Icon="{StaticResource I.trash}" Margin="5,0,0,0" Click="Delete_Click" ToolTip="Del · can be undone"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock x:Name="NoSelection" Text="Select a replay" Foreground="{StaticResource Text3}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </ui:Chamfer>
    </Grid>
</UserControl>
