<UserControl x:Class="CommandCenter.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CommandCenter.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="30,26,30,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition x:Name="SideCol" Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: greeting, launch, stats, last match ── -->
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="32" Height="2" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <ui:TrackedText Text="Welcome back, General" FontSize="13" Tracking="0.32" Foreground="{StaticResource Accent}" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBlock Margin="0,10,0,0" FontSize="58" FontWeight="Bold" FontStretch="Condensed" LineHeight="56" LineStackingStrategy="BlockLineHeight" Foreground="#F3EFE6">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.8" Color="Black"/></TextBlock.Effect>
                    <Run Text="READY FOR "/><Run Text="BATTLE" Foreground="{StaticResource Accent}"/><Run Text=","/><LineBreak/><Run Text="COMMANDER"/>
                </TextBlock>
                <TextBlock x:Name="Status" Margin="0,14,0,0" FontSize="16.5" Foreground="#D2D0C8" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" LineHeight="23">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.9" Color="Black"/></TextBlock.Effect>
                    Checking your game…
                </TextBlock>

                <!-- Launch -->
                <ui:Chamfer Style="{StaticResource Panel}" Margin="0,26,0,0" Padding="26,24">
                    <ui:Chamfer.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#DB1A1D1F" Offset="0"/>
                            <GradientStop Color="#E60D0F10" Offset="1"/>
                        </LinearGradientBrush>
                    </ui:Chamfer.Background>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PlayOnline" ui:Ui.Variant="Primary" ui:Ui.Icon="{StaticResource I.play}" ui:Ui.IconFilled="True" ui:Ui.Cut="14"
                                    Height="88" FontSize="32" Content="Play online" Click="PlayOnline_Click" ToolTip="Start Generals Online (Ctrl+Enter)"/>
                            <StackPanel x:Name="ChannelBox" Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                                <ui:TrackedText Style="{StaticResource Lbl}" Text="Client channel"/>
                                <Border Style="{StaticResource SegBox}" Margin="0,9,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="Live" Style="{StaticResource Seg}" Content="Live" GroupName="channel" Checked="Channel_Checked"/>
                                        <RadioButton x:Name="Test" Style="{StaticResource Seg}" Content="Test" GroupName="channel" Checked="Channel_Checked"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <WrapPanel x:Name="Chips" Margin="0,20,0,0"/>
                    </StackPanel>
                </ui:Chamfer>

                <!-- Stats -->
                <UniformGrid Columns="3" Margin="0,16,0,0">
                    <ui:Chamfer Style="{StaticResource Panel}" Padding="20,16" Margin="0,0,8,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:Icon Data="{StaticResource I.users}" Width="17" Height="17" Foreground="{StaticResource Accent}"/>
                                <ui:TrackedText Style="{StaticResource Lbl}" Text="Players online" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="Players" Style="{StaticResource Big}" Text="—" Margin="0,10,0,0"/>
                            <TextBlock Text="Signed in to Generals Online now" Style="{StaticResource Small}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ui:Chamfer>
                    <ui:Chamfer Style="{StaticResource Panel}" Padding="20,16" Margin="4,0,4,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:Icon Data="{StaticResource I.door}" Width="17" Height="17" Foreground="{StaticResource Accent}"/>
                                <ui:TrackedText Style="{StaticResource Lbl}" Text="Open lobbies" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="Lobbies" Style="{StaticResource Big}" Text="—" Margin="0,10,0,0"/>
                            <TextBlock Text="Games waiting for players" Style="{StaticResource Small}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ui:Chamfer>
                    <ui:Chamfer Style="{StaticResource Panel}" Padding="20,16" Margin="8,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:Icon Data="{StaticResource I.signal}" Width="17" Height="17" Foreground="{StaticResource Accent}"/>
                                <ui:TrackedText Style="{StaticResource Lbl}" Text="Server response" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0">
                                <Run x:Name="Latency" Text="—" FontSize="38" FontWeight="Bold" FontStretch="Condensed"/><Run Text=" ms" FontSize="20" Foreground="{StaticResource Text3}"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <ui:StatusMark x:Name="LatencyMark" Mark="None" Width="12" Height="12" Margin="0,0,6,0"/>
                                <TextBlock x:Name="LatencyText" Text="Measuring" Style="{StaticResource Small}"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Chamfer>
                </UniformGrid>

                <!-- Last match -->
                <ui:Chamfer x:Name="LastMatch" Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="24,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="150" Height="150" Padding="5" Background="#0B0C0D" BorderBrush="#3A4044" BorderThickness="1" VerticalAlignment="Top">
                            <Grid>
                                <Image x:Name="MatchMap" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <ui:Icon x:Name="MatchMapNone" Data="{StaticResource I.map}" Width="44" Height="44" Foreground="#3A4044"/>
                            </Grid>
                        </Border>
                        <DockPanel Grid.Column="1" Margin="24,2,0,0">
                            <StackPanel DockPanel.Dock="Top">
                                <ui:TrackedText x:Name="MatchKicker" Style="{StaticResource Lbl}" Text="Last match"/>
                                <TextBlock x:Name="MatchTitle" Text="No matches yet" FontSize="25" FontWeight="Bold" FontStretch="Condensed" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                                <WrapPanel x:Name="MatchPlayers" Margin="0,10,0,0"/>
                            </StackPanel>
                            <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,14,0,0">
                                <TextBlock x:Name="MatchInfo" Style="{StaticResource Small}" VerticalAlignment="Center" FontSize="13"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSm}" Content="All replays" ui:Ui.Icon="{StaticResource I.replay}" Margin="10,0,0,0" Click="AllReplays_Click"/>
                                <Button x:Name="WatchMatch" DockPanel.Dock="Right" Style="{StaticResource BtnSm}" Content="Watch" ui:Ui.Icon="{StaticResource I.eye}" Click="Watch_Click"/>
                            </DockPanel>
                            <Border/>
                        </DockPanel>
                    </Grid>
                </ui:Chamfer>
            </StackPanel>

            <!-- ── Right: health, quick actions, recent changes ── -->
            <StackPanel Grid.Column="2">
                <ui:Chamfer Style="{StaticResource Panel}">
                    <StackPanel>
                        <HeaderedContentControl Style="{StaticResource PanelHead}" Header="Game health" ui:Ui.Icon="{StaticResource I.shield}" x:Name="HealthHead" ui:Ui.Subtitle="Checking…"/>
                        <Grid Margin="20,18,20,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="86" Height="86">
                                <ui:ScoreRing x:Name="Ring" Thickness="8"/>
                                <TextBlock x:Name="Score" Text="…" FontSize="24" FontWeight="Bold" FontStretch="Condensed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="IssueCount" Text="Checking" FontSize="27" FontWeight="Bold" FontStretch="Condensed"/>
                                <TextBlock x:Name="HealthNote" Text="Nothing changes until you press Fix. Every fix can be undone." Style="{StaticResource Body}" FontSize="13" LineHeight="18" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="IssueList" Margin="20,6,20,18"/>
                    </StackPanel>
                </ui:Chamfer>

                <ui:Chamfer Style="{StaticResource Panel}" Margin="0,16,0,0">
                    <StackPanel>
                        <HeaderedContentControl Style="{StaticResource PanelHead}" Header="Quick actions" ui:Ui.Icon="{StaticResource I.bolt}"/>
                        <UniformGrid Columns="2" Margin="18,16,18,18">
                            <Button Style="{StaticResource TileBtn}" Content="Get maps" ui:Ui.Icon="{StaticResource I.map}" Margin="0,0,5,10" Tag="maps" Click="Go_Click"/>
                            <Button Style="{StaticResource TileBtn}" Content="Edit hotkeys" ui:Ui.Icon="{StaticResource I.keys}" Margin="5,0,0,10" Tag="hotkeys" Click="Go_Click"/>
                            <Button Style="{StaticResource TileBtn}" Content="Control bar" ui:Ui.Icon="{StaticResource I.cube}" Margin="0,0,5,0" Tag="addons" Click="Go_Click"/>
                            <Button Style="{StaticResource TileBtn}" Content="Support report" ui:Ui.Icon="{StaticResource I.copy}" Margin="5,0,0,0" Click="Report_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </ui:Chamfer>

                <ui:Chamfer Style="{StaticResource Panel}" Margin="0,16,0,0">
                    <StackPanel>
                        <HeaderedContentControl Style="{StaticResource PanelHead}" Header="Recent changes" ui:Ui.Icon="{StaticResource I.clock}" ui:Ui.Subtitle="What the launcher changed, newest first"/>
                        <StackPanel x:Name="Changes" Margin="0,4,0,10"/>
                    </StackPanel>
                </ui:Chamfer>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
