<UserControl x:Class="CommandCenter.Pages.HealthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CommandCenter.Controls">
    <UserControl.Resources>
        <!-- Counter tile: number, shape and word -->
        <Style x:Key="Counter" TargetType="ui:Chamfer" BasedOn="{StaticResource Tile}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="30,24,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Summary -->
            <ui:Chamfer Style="{StaticResource Panel}" Padding="26,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="94" Height="94" VerticalAlignment="Center">
                        <ui:ScoreRing x:Name="Ring" Thickness="9"/>
                        <TextBlock x:Name="Score" Text="…" FontSize="25" FontWeight="Bold" FontStretch="Condensed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="22,0,20,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Headline" Text="Checking your game" FontSize="30" FontWeight="Bold" FontStretch="Condensed" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="Subline" Style="{StaticResource Body}" Margin="0,4,0,0" MaxWidth="560" HorizontalAlignment="Left"
                                   Text="Nothing changes until you press a button. Every fix keeps a backup and can be undone."/>
                        <!-- Counts: number, shape and word -->
                        <WrapPanel Margin="0,12,0,0">
                            <ui:Chamfer Style="{StaticResource Counter}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PassedCount" Text="0" FontSize="20" FontWeight="Bold" FontStretch="Condensed" Foreground="{StaticResource Ok}" VerticalAlignment="Center"/>
                                    <ui:StatusMark Mark="Ok" Width="13" Height="13" Margin="7,0,8,0" VerticalAlignment="Center"/>
                                    <ui:TrackedText Style="{StaticResource Lbl}" Text="Passed" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Chamfer>
                            <ui:Chamfer Style="{StaticResource Counter}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="WarnCount" Text="0" FontSize="20" FontWeight="Bold" FontStretch="Condensed" Foreground="{StaticResource Warn}" VerticalAlignment="Center"/>
                                    <ui:StatusMark Mark="Warn" Width="14" Height="14" Margin="7,0,8,0" VerticalAlignment="Center"/>
                                    <ui:TrackedText x:Name="WarnWord" Style="{StaticResource Lbl}" Text="Warnings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Chamfer>
                            <ui:Chamfer Style="{StaticResource Counter}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ProblemCount" Text="0" FontSize="20" FontWeight="Bold" FontStretch="Condensed" Foreground="{StaticResource Danger}" VerticalAlignment="Center"/>
                                    <ui:StatusMark Mark="Danger" Width="13" Height="13" Margin="7,0,8,0" VerticalAlignment="Center"/>
                                    <ui:TrackedText x:Name="ProblemWord" Style="{StaticResource Lbl}" Text="Problems" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Chamfer>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ScanBtn" Style="{StaticResource BtnLg}" Content="Scan again" ui:Ui.Icon="{StaticResource I.refresh}" Click="Scan_Click"/>
                        <Button x:Name="FixAllBtn" Style="{StaticResource BtnLg}" ui:Ui.Variant="Primary" ui:Ui.Icon="{StaticResource I.wrench}" Content="Fix all" Margin="12,0,0,0" Click="FixAll_Click"/>
                    </StackPanel>
                </Grid>
            </ui:Chamfer>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition x:Name="SideCol" Width="380"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Needs attention -->
                    <ui:Chamfer x:Name="AttentionPanel" Style="{StaticResource Panel}">
                        <StackPanel>
                            <HeaderedContentControl x:Name="AttentionHead" Style="{StaticResource PanelHead}" Header="Needs attention" ui:Ui.Icon="{StaticResource I.warn}"
                                                    ui:Ui.Subtitle="Problems first, then warnings"/>
                            <StackPanel x:Name="Attention"/>
                        </StackPanel>
                    </ui:Chamfer>

                    <!-- Passed, folded by default -->
                    <ui:Chamfer Style="{StaticResource Panel}" Margin="0,18,0,0">
                        <StackPanel>
                            <HeaderedContentControl x:Name="PassedHead" Style="{StaticResource PanelHead}" Header="Passed" ui:Ui.Icon="{StaticResource I.okc}">
                                <Button x:Name="TogglePassed" Style="{StaticResource BtnSm}" Content="Show" ui:Ui.Icon="{StaticResource I.chev}" Click="TogglePassed_Click"/>
                            </HeaderedContentControl>
                            <StackPanel x:Name="Passed" Visibility="Collapsed" Margin="0,0,0,8"/>
                        </StackPanel>
                    </ui:Chamfer>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <ui:Chamfer Style="{StaticResource Panel}">
                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource PanelHead}" Header="Fix history" ui:Ui.Icon="{StaticResource I.clock}" ui:Ui.Subtitle="Undo any change the launcher made"/>
                            <StackPanel x:Name="History" Margin="0,4,0,10"/>
                        </StackPanel>
                    </ui:Chamfer>
                    <ui:Chamfer Style="{StaticResource Panel}" Margin="0,18,0,0">
                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource PanelHead}" Header="Support report" ui:Ui.Icon="{StaticResource I.copy}"/>
                            <TextBlock Style="{StaticResource Body}" Margin="20,14,20,0" FontSize="13.5"
                                       Text="Copies a summary of your system, game and these checks for the Generals Online Discord. Your Windows user name and PC name are hidden."/>
                            <Button Content="Copy report" ui:Ui.Icon="{StaticResource I.copy}" Margin="20,14,20,20" Click="Report_Click"/>
                        </StackPanel>
                    </ui:Chamfer>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
