<Page
    x:Class="CommandCenter.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:CommandCenter.Services"
    Background="#01031A">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="165"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left sidebar -->
        <Grid Grid.Column="0" Background="#00020F">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,8,0,0">
                <RadioButton x:Name="TabHealth" Tag="health" GroupName="ToolsTabs" Style="{StaticResource NavTabStyle}" Checked="Tab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:T HEALTH}" VerticalAlignment="Center"/>
                        <Border x:Name="HealthBadge" Background="#FF4444" CornerRadius="2" Padding="5,0" Margin="8,0,0,0"
                                VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="HealthBadgeText" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabMaps" Tag="maps" Content="{l:T MAP LIBRARY}" GroupName="ToolsTabs" Style="{StaticResource NavTabStyle}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabReplays" Tag="replays" Content="{l:T REPLAYS}" GroupName="ToolsTabs" Style="{StaticResource NavTabStyle}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabHotkeys" Tag="hotkeys" Content="{l:T HOTKEYS}" GroupName="ToolsTabs" Style="{StaticResource NavTabStyle}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabAddons" Tag="addons" Content="{l:T ADD-ONS}" GroupName="ToolsTabs" Style="{StaticResource NavTabStyle}" Checked="Tab_Checked"/>
            </StackPanel>

            <Button Grid.Row="1" Content="{l:T GO BACK}" Style="{StaticResource BackButtonStyle}" Click="Back_Click"/>
        </Grid>

        <!-- One section at a time -->
        <ContentControl x:Name="SectionHost" Grid.Column="1" Margin="24,20,24,16" Focusable="False"/>
    </Grid>
</Page>
