<UserControl x:Class="CommandCenter.Pages.UpdateOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:CommandCenter.Services"
             Visibility="Collapsed">
    <UserControl.Resources>
        <Style x:Key="BarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#1E1E2E" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="#2980FF" CornerRadius="3" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Covers the whole window. The only ways out are installing the update or closing the window. -->
    <Grid Background="#F001031A">
        <!-- The window's own close button is underneath, so the overlay brings its own in the same place -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="46" Height="32" Content="✕" Foreground="White"
                FontSize="14" Background="Transparent" BorderThickness="0" Cursor="Hand"
                WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="{l:T Close}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#C42B1C"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Border Style="{StaticResource ResultBoxStyle}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20,24,20">
            <StackPanel>
                <TextBlock Text="{l:T UPDATE REQUIRED}" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Left"/>
                <TextBlock x:Name="Message" Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock x:Name="Versions" Style="{StaticResource HintStyle}" Margin="0,4,0,0"/>

                <StackPanel x:Name="NotesBox" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource GroupLabelStyle}">
                        <TextBlock.Text><l:T Text="WHAT'S NEW"/></TextBlock.Text>
                    </TextBlock>
                    <TextBlock x:Name="Notes" Foreground="#C0C0D0" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel x:Name="ProgressBox" Margin="0,16,0,0" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock x:Name="Percent" DockPanel.Dock="Right" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="Stage" Foreground="#8888AA" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <ProgressBar x:Name="Bar" Style="{StaticResource BarStyle}" Maximum="1" Margin="0,8,0,0"/>
                </StackPanel>

                <TextBlock x:Name="Error" Foreground="#FF6B6B" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button x:Name="UpdateNow" Style="{StaticResource GoldButtonStyle}" Content="{l:T UPDATE NOW}" Click="UpdateNow_Click"
                            ToolTip="{l:T Download, check and install the new version (Enter)}"/>
                    <Button x:Name="DownloadPage" Style="{StaticResource DiagButtonStyle}" Content="{l:T DOWNLOAD PAGE}" Margin="10,0,0,0"
                            Visibility="Collapsed" Click="DownloadPage_Click"/>
                    <Button Style="{StaticResource DiagButtonStyle}" Content="{l:T CLOSE}" Margin="10,0,0,0" Click="Close_Click"/>
                </StackPanel>
                <TextBlock Style="{StaticResource HintStyle}" Margin="0,12,0,0"
                           Text="{l:T Command Center downloads the new version, checks it and restarts by itself.}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
