<Page
    x:Class="CommandCenter.Pages.LauncherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CommandCenter.Controls"
    xmlns:l="clr-namespace:CommandCenter.Services"
    Background="Transparent">

    <Page.Resources>
        <!-- PLAY: solid gold with a soft glow -->
        <Style x:Key="HeroPlayStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#1A1300"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="270"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" CornerRadius="14" Background="#FECD03">
                            <Border.Effect>
                                <DropShadowEffect x:Name="Glow" Color="#FECD03" BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.45"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#FFD83A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#E6B800"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChannelTab" TargetType="RadioButton" BasedOn="{StaticResource SubTabStyle}">
            <Setter Property="GroupName" Value="Channel"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontStretch" Value="Condensed"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="TileTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="TileSub" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#A7AECB"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Numeral" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontStretch" Value="Condensed"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>
    </Page.Resources>

    <Grid Margin="40,6,40,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Title, game details, PLAY and the health line -->
            <StackPanel x:Name="HeroBlock" VerticalAlignment="Bottom" Margin="0,0,28,4">
                <TextBlock Text="C&amp;C GENERALS · ZERO HOUR" Style="{StaticResource NameTextStyle}" Foreground="#FECD03" FontFamily="Bahnschrift"
                           FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="{l:T Ready for battle}" FontSize="46" FontWeight="Bold" Margin="0,2,0,12">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.65" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>

                <WrapPanel>
                    <Border Style="{StaticResource ChipStyle}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <c:Icon Kind="server" Width="14" Height="14" Foreground="#7AB4FF" Margin="0,0,7,0"/>
                            <TextBlock x:Name="VersionText" FlowDirection="LeftToRight" FontSize="12" Foreground="#D5D9EA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="AntiCheatChip" Style="{StaticResource ChipStyle}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <c:Icon Kind="shield" Width="14" Height="14" Foreground="#52D273" Margin="0,0,7,0"/>
                            <TextBlock x:Name="AntiCheatText" FlowDirection="LeftToRight" FontSize="12" Foreground="#D5D9EA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="SourceChip" Click="SourceChip_Click" Cursor="Hand" Margin="0,0,8,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Back" Style="{StaticResource ChipStyle}" Margin="0">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Back" Property="BorderBrush" Value="#59FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="drive" Width="14" Height="14" Foreground="#FECD03" Margin="0,0,7,0"/>
                            <TextBlock x:Name="SourceText" FontSize="12" Foreground="#D5D9EA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
                    <Button x:Name="PlayButton" Style="{StaticResource HeroPlayStyle}" Click="BtnPlay_Click" AutomationProperties.Name="{l:T PLAY}">
                        <Grid ClipToBounds="True">
                            <Rectangle x:Name="Sheen" Width="60" HorizontalAlignment="Left" Margin="0,-10" Opacity="0.45" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#CCFFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <SkewTransform AngleX="-18"/>
                                        <TranslateTransform x:Name="SheenMove" X="-90"/>
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <StackPanel x:Name="PlayIdle" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <c:Icon Kind="play" Width="24" Height="24" Foreground="#1A1300" Margin="0,0,14,0"/>
                                <TextBlock x:Name="PlayText" Text="{l:T PLAY}" FontSize="24" FontWeight="Bold" Foreground="#1A1300" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="PlayBusy" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <Path x:Name="Spinner" Width="22" Height="22" Stretch="Uniform" Stroke="#1A1300" StrokeThickness="2.6" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Data="M21,12 A9,9 0 1 1 14.78,3.44" RenderTransformOrigin="0.5,0.5" Margin="0,0,12,0">
                                    <Path.RenderTransform>
                                        <RotateTransform/>
                                    </Path.RenderTransform>
                                </Path>
                                <TextBlock x:Name="PlayBusyText" FontSize="18" FontWeight="Bold" Foreground="#1A1300" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Border x:Name="ClientSelectorPanel" Style="{StaticResource GlassCardStyle}" CornerRadius="12" Padding="4" Margin="12,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <RadioButton x:Name="rbLiveClient" Content="LIVE" Style="{StaticResource ChannelTab}" Checked="ClientSelector_Changed"/>
                            <RadioButton x:Name="rbTestEnv" Content="TEST" Style="{StaticResource ChannelTab}" Checked="ClientSelector_Changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button x:Name="HealthChip" Click="HealthChip_Click" Cursor="Hand" HorizontalAlignment="Left" Visibility="Collapsed">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Back" CornerRadius="10" Height="38" Padding="14,0" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <c:Icon x:Name="HealthIcon" Kind="alert" Width="16" Height="16" Margin="0,0,10,0"/>
                        <TextBlock x:Name="HealthText" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HealthReview" Text="{l:T REVIEW}" FontSize="13" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Servers and the last match -->
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4">
                <Border x:Name="ServerCard" Style="{StaticResource GlassCardStyle}" Padding="18,14">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ServerDot" Width="7" Height="7" Fill="#52D273" Margin="0,0,6,0"/>
                                <TextBlock x:Name="ServerState" FontSize="11" Foreground="#7BE39A" VerticalAlignment="Center"/>
                            </StackPanel>
                            <c:Icon Kind="activity" Width="16" Height="16" Foreground="#7AB4FF" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:T Servers}" FontSize="13" FontWeight="SemiBold" Foreground="#D5D9EA" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="PlayersText" Style="{StaticResource Numeral}" FontSize="48" Text="—"/>
                            <TextBlock Text="{l:T online now}" FontSize="13" Foreground="#A7AECB" VerticalAlignment="Bottom" Margin="8,0,0,9"/>
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="10" Background="#0DFFFFFF" Padding="10,7">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Kind="users" Width="16" Height="16" Foreground="#A7AECB" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock x:Name="LobbiesText" Style="{StaticResource Numeral}" FontSize="18" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{l:T Lobbies}" FontSize="11" Foreground="#A7AECB"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" CornerRadius="10" Background="#0DFFFFFF" Padding="10,7">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Kind="signal" Width="16" Height="16" Foreground="#A7AECB" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock x:Name="PingText" Style="{StaticResource Numeral}" FontSize="18" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{l:T Ping}" FontSize="11" Foreground="#A7AECB"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="LastMatchCard" Style="{StaticResource GlassCardStyle}" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="10" Margin="0,0,12,0">
                            <Border.Background>
                                <ImageBrush x:Name="LastMatchMap" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="38" Height="38" Click="WatchLast_Click"
                                ToolTip="{l:T Watch}" AutomationProperties.Name="{l:T Watch}" VerticalAlignment="Center" Margin="8,0,0,0">
                            <c:Icon Kind="play" Width="14" Height="14"/>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <DockPanel>
                                <Border x:Name="LastResultChip" DockPanel.Dock="Right" CornerRadius="8" Padding="8,1" Visibility="Collapsed">
                                    <TextBlock x:Name="LastResult" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <c:Icon Kind="trophy" Width="13" Height="13" Foreground="#A7AECB" Margin="0,0,6,0"/>
                                <TextBlock Text="{l:T Last match}" FontSize="11" Foreground="#A7AECB" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="LastMatchName" Style="{StaticResource NameTextStyle}" FontSize="14" FontWeight="Bold" Margin="0,3,0,2"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="LastMatchInfo" FontSize="11" Foreground="#A7AECB" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Quick ways into the tools -->
        <Grid x:Name="Tiles" Grid.Row="1" Height="76" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource CardButtonStyle}" Padding="14,0" Tag="maps" Click="Tile_Click">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="12" Background="#292980FF" Margin="0,0,12,0">
                        <c:Icon Kind="map" Width="20" Height="20" Foreground="#7AB4FF"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:T Map library}" Style="{StaticResource TileTitle}"/>
                        <TextBlock x:Name="MapsTileText" Style="{StaticResource TileSub}"/>
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource CardButtonStyle}" Padding="14,0" Tag="replays" Click="Tile_Click">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="12" Background="#29B07AFF" Margin="0,0,12,0">
                        <c:Icon Kind="film" Width="20" Height="20" Foreground="#C3A0FF"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:T Replays}" Style="{StaticResource TileTitle}"/>
                        <TextBlock x:Name="ReplaysTileText" Style="{StaticResource TileSub}"/>
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource CardButtonStyle}" Padding="14,0" Tag="hotkeys" Click="Tile_Click">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="12" Background="#2652D273" Margin="0,0,12,0">
                        <c:Icon Kind="keyboard" Width="20" Height="20" Foreground="#7BE39A"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:T Hotkeys}" Style="{StaticResource TileTitle}"/>
                        <TextBlock Text="{l:T Every army, every button}" Style="{StaticResource TileSub}"/>
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Grid.Column="6" Style="{StaticResource CardButtonStyle}" Padding="14,0" Tag="addons" Click="Tile_Click">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="12" Background="#24FECD03" Margin="0,0,12,0">
                        <c:Icon Kind="layers" Width="20" Height="20" Foreground="#FECD03"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:T Control bar}" Style="{StaticResource TileTitle}"/>
                        <TextBlock x:Name="BarTileText" Style="{StaticResource TileSub}"/>
                    </StackPanel>
                </DockPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
