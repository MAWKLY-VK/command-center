<UserControl x:Class="CommandCenter.Pages.Tools.ReplaysSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CommandCenter.Controls"
             xmlns:l="clr-namespace:CommandCenter.Services"
             xmlns:t="clr-namespace:CommandCenter.Pages.Tools">
    <UserControl.Resources>
        <!-- A replay as a glass card; blue when selected -->
        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="#A60A0E20" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="14"
                                Padding="10,8,12,8" Margin="0,0,0,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38224A8C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2980FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ReplayTemplate">
            <Grid MinHeight="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="50" Height="50" CornerRadius="10" HorizontalAlignment="Left" FlowDirection="LeftToRight">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="{Binding Map}" Style="{StaticResource NameTextStyle}" FontSize="14" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Map}"/>
                    <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{Binding SubBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <t:PlayerStrip Grid.Column="2" Players="{Binding Chips}" VerticalAlignment="Center" Margin="0,0,14,0"
                               ToolTip="{Binding PlayersTip}"/>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Day}" FontSize="12" Foreground="#D5D9EA" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Length}" FontFamily="Bahnschrift" FontWeight="SemiBold" FontStretch="Condensed" FontSize="14"
                               Foreground="#A7AECB" Margin="0,1,0,0"/>
                </StackPanel>
                <Border Grid.Column="4" MinWidth="64" MaxWidth="120" Height="26" CornerRadius="8" Padding="8,0" Background="{Binding ResultFill}"
                        VerticalAlignment="Center" Visibility="{Binding ResultVisibility}" ToolTip="{Binding ResultTip}">
                    <TextBlock Text="{Binding ResultText}" Foreground="{Binding ResultBrush}" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#A7AECB"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title and count, the game's archive option, search and folder -->
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="40" Height="40" Margin="10,0,0,0"
                    VerticalAlignment="Center" Click="OpenFolder_Click" ToolTip="{l:T OPEN FOLDER}" AutomationProperties.Name="{l:T OPEN FOLDER}">
                <c:Icon Kind="folder" Width="17" Height="17"/>
            </Button>
            <Border DockPanel.Dock="Right" Width="230" Height="40" CornerRadius="12" Background="#B30A0E20" BorderBrush="#1FFFFFFF"
                    BorderThickness="1" VerticalAlignment="Center" Margin="10,0,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <c:Icon Kind="search" Width="16" Height="16" Foreground="#A7AECB" Margin="0,0,8,0"/>
                    <TextBox x:Name="Search" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="NaN" Background="Transparent"
                             BorderThickness="0" Padding="0" TextChanged="Search_Changed"/>
                    <TextBlock x:Name="SearchHint" Grid.Column="1" Text="{l:T Search map or player}" Foreground="#7A82A0" FontSize="13"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <CheckBox x:Name="Archive" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                      Click="Archive_Click" Content="{l:T Archive every match}"
                      ToolTip="{l:T The game then keeps a copy of each match in ArchivedReplays, so the next one does not replace it.}"/>
            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Text="{l:T REPLAYS}" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock x:Name="Status" Style="{StaticResource HintStyle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- The list -->
            <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Padding="0"
                     ItemContainerStyle="{StaticResource RowStyle}" ItemTemplate="{StaticResource ReplayTemplate}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" SelectionMode="Single"
                     SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_DoubleClick" KeyDown="List_KeyDown">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
            </ListBox>
            <Border x:Name="Empty" Style="{StaticResource GlassCardStyle}" Padding="28,22" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="420" Visibility="Collapsed">
                <StackPanel>
                    <c:Icon Kind="film" Width="30" Height="30" Foreground="#C3A0FF" Margin="0,0,0,10"/>
                    <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource HintStyle}" HorizontalAlignment="Center" TextAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- The selected match: map, result, numbers, players, file actions, then Watch -->
            <Border x:Name="Panel" Grid.Column="2" Style="{StaticResource GlassCardStyle}" CornerRadius="18" Background="#BD0A0E20"
                    DataContext="{Binding SelectedItem, ElementName=List}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="132">
                        <Border CornerRadius="17,17,0,0" Background="#0A0E20" FlowDirection="LeftToRight">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="White" Offset="0.3"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                            <Border CornerRadius="17,17,0,0">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Border>
                        <Border Margin="14,12" Height="26" CornerRadius="8" Padding="10,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="{Binding ResultFill}" Visibility="{Binding ResultVisibility}">
                            <TextBlock Text="{Binding ResultText}" Foreground="{Binding ResultBrush}" FontSize="12" FontWeight="Bold"
                                       VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <TextBlock Text="{Binding Map}" Style="{StaticResource NameTextStyle}" FontSize="18" FontWeight="Bold" Margin="16,0,16,6"
                                   VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.8" Color="Black"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>

                    <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="12,8,12,0">
                        <Border CornerRadius="10" Background="#0DFFFFFF" Padding="9,6" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{l:T Date}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Day}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="10" Background="#0DFFFFFF" Padding="9,6" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{l:T Length}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Length}" FontFamily="Bahnschrift" FontWeight="Bold" FontStretch="Condensed" FontSize="15"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="10" Background="#0DFFFFFF" Padding="9,6">
                            <StackPanel>
                                <TextBlock Text="{l:T Money}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Money}" FontFamily="Bahnschrift" FontWeight="Bold" FontStretch="Condensed" FontSize="15"
                                           FlowDirection="LeftToRight" TextAlignment="{x:Static l:Loc.StartAlignment}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,12">
                        <Button x:Name="KeepButton" Style="{StaticResource DiagButtonStyle}" Height="38" Margin="0,0,0,8" Visibility="Collapsed"
                                Click="Keep_Click"
                                ToolTip="{l:T The game overwrites 00000000.rep after every match; this saves a copy with a readable name}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="save" Width="15" Height="15" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T KEEP THIS MATCH}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="WatchButton" Style="{StaticResource GoldButtonStyle}" Height="42" IsEnabled="False"
                                Click="Watch_Click" ToolTip="{l:T Starts the game in replay mode (Enter)}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="play" Width="15" Height="15" Margin="0,0,9,0"/>
                                <TextBlock Text="{l:T WATCH}" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Margin="12,10,4,0">
                        <ContentPresenter Content="{Binding Details}" Margin="0,0,8,0"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
