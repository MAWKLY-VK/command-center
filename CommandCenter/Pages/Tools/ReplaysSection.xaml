<UserControl x:Class="CommandCenter.Pages.Tools.ReplaysSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:CommandCenter.Services">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{l:T REPLAYS}" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Left"/>
        <TextBlock Grid.Row="1" Text="Being rebuilt." Style="{StaticResource HintStyle}"/>
    </Grid>
</UserControl>
