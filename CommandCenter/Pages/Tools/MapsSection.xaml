<UserControl x:Class="CommandCenter.Pages.Tools.MapsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CommandCenter.Controls"
             xmlns:l="clr-namespace:CommandCenter.Services"
             AllowDrop="True" DragEnter="Section_DragEnter">
    <UserControl.Resources>
        <!-- One map: its picture with the player count and size, a round tick, then the name -->
        <DataTemplate x:Key="TileTemplate">
            <Border x:Name="Tile" Width="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Margin="0,0,12,12" Background="#BF0A0E20" BorderBrush="#17FFFFFF" BorderThickness="1" CornerRadius="14"
                    Cursor="{Binding Cursor}" ToolTip="{Binding Tip}" RenderTransformOrigin="0.5,0.5"
                    MouseLeftButtonUp="Tile_Click" Loaded="Tile_Loaded" Unloaded="Tile_Unloaded">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <StackPanel>
                    <Grid Height="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Border CornerRadius="13,13,0,0" Background="#0A0E20"/>
                        <Border CornerRadius="13,13,0,0" Opacity="{Binding ImageOpacity}" FlowDirection="LeftToRight">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="13,13,0,0" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Color="#D9050814" Offset="0"/>
                                    <GradientStop Color="#00050814" Offset="0.5"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="{l:T NO PREVIEW}" FontSize="9" FontWeight="Bold" Foreground="#59FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoPreviewVisibility}"/>

                        <!-- Tick: an empty ring, blue with a check when chosen -->
                        <Grid x:Name="Box" Width="24" Height="24" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                              Visibility="{Binding CheckVisibility}">
                            <Ellipse x:Name="BoxRing" Fill="#59050814" Stroke="#B3FFFFFF" StrokeThickness="2"/>
                            <Path x:Name="Mark" Data="M7,12.5 L10.5,16 L17,8.5" Stroke="White" StrokeThickness="2.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  FlowDirection="LeftToRight" Visibility="Collapsed"/>
                        </Grid>
                        <Border Margin="8" Padding="7,0" Height="22" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="#E60C2816" BorderBrush="#9952D273" BorderThickness="1" Visibility="{Binding InstalledVisibility}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="check" Width="10" Height="10" StrokeThickness="3" Foreground="#7BE39A" Margin="0,0,4,0"/>
                                <TextBlock Text="{l:T INSTALLED}" FontSize="10" FontWeight="Bold" Foreground="#7BE39A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="9,0,9,8" VerticalAlignment="Bottom" FlowDirection="LeftToRight"
                                    HorizontalAlignment="Left">
                            <Border Height="20" Padding="6,0" CornerRadius="6" Background="#BF050814" Margin="0,0,6,0"
                                    Visibility="{Binding PlayersVisibility}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Kind="users" Width="11" Height="11" Foreground="#D5D9EA" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding PlayersText}" FontFamily="Bahnschrift" FontWeight="Bold" FontStretch="Condensed"
                                               FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="#C9CEE0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource NameTextStyle}" FontSize="12.5" FontWeight="Bold"
                               Margin="10,7,10,9" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="#40FFFFFF"/>
                </Trigger>
                <DataTrigger Binding="{Binding Checked}" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="#2980FF"/>
                    <Setter TargetName="Tile" Property="Background" Value="#33224A8C"/>
                    <Setter TargetName="BoxRing" Property="Fill" Value="#2980FF"/>
                    <Setter TargetName="BoxRing" Property="Stroke" Value="#2980FF"/>
                    <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A row of tiles; the rows are virtualized, so only the rows on screen exist -->
        <DataTemplate x:Key="RowTemplate">
            <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource TileTemplate}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- Thin progress line along the bottom of the action bar -->
        <Style x:Key="LineProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#1FFFFFFF" CornerRadius="1.5"/>
                            <Border x:Name="PART_Indicator" Background="#FECD03" CornerRadius="1.5" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DiagButtonStyle}">
            <Setter Property="Background" Value="#1FFF6B6B"/>
            <Setter Property="BorderBrush" Value="#99FF6B6B"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title, library or installed, search -->
        <DockPanel>
            <Border DockPanel.Dock="Right" Width="250" Height="40" CornerRadius="12" Background="#B30A0E20" BorderBrush="#1FFFFFFF"
                    BorderThickness="1" VerticalAlignment="Center">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <c:Icon Kind="search" Width="16" Height="16" Foreground="#A7AECB" Margin="0,0,8,0"/>
                    <TextBox x:Name="Search" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="NaN" Background="Transparent"
                             BorderThickness="0" Padding="0" TextChanged="Search_Changed"/>
                    <TextBlock x:Name="SearchHint" Grid.Column="1" Text="{l:T Search maps}" Foreground="#7A82A0" FontSize="13"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:T MAP LIBRARY}" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
                <Border Style="{StaticResource SegmentStyle}" Margin="18,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabLibrary" GroupName="MapTabs" Style="{StaticResource SubTabStyle}" IsChecked="True"
                                     Margin="0" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabInstalled" GroupName="MapTabs" Style="{StaticResource SubTabStyle}"
                                     Margin="0" Checked="Tab_Checked"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- How many players, and where the library comes from -->
        <DockPanel Grid.Row="1" Margin="0,14,0,12">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <RadioButton GroupName="Players" Style="{StaticResource FilterChipStyle}" Tag="0" IsChecked="True" Content="{l:T All}"
                             Checked="Players_Checked"/>
                <RadioButton GroupName="Players" Style="{StaticResource FilterChipStyle}" Tag="1" Checked="Players_Checked">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="users" Width="13" Height="13" Margin="0,0,6,0"/>
                        <TextBlock Text="2" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Players" Style="{StaticResource FilterChipStyle}" Tag="2" Checked="Players_Checked">
                    <TextBlock Text="3–4" FlowDirection="LeftToRight"/>
                </RadioButton>
                <RadioButton GroupName="Players" Style="{StaticResource FilterChipStyle}" Tag="3" Checked="Players_Checked">
                    <TextBlock Text="5–6" FlowDirection="LeftToRight"/>
                </RadioButton>
                <RadioButton GroupName="Players" Style="{StaticResource FilterChipStyle}" Tag="4" Checked="Players_Checked">
                    <TextBlock Text="7–8" FlowDirection="LeftToRight"/>
                </RadioButton>
            </StackPanel>
            <TextBlock x:Name="Summary" Foreground="#A7AECB" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"
                       TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Tiles -->
        <Grid Grid.Row="2">
            <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource RowTemplate}" Focusable="False"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                          SizeChanged="Rows_SizeChanged">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="Scroller" CanContentScroll="True" Focusable="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border x:Name="Empty" Style="{StaticResource GlassCardStyle}" Padding="28,22" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="460" Visibility="Collapsed">
                <StackPanel>
                    <c:Icon Kind="map" Width="30" Height="30" Foreground="#7AB4FF" Margin="0,0,0,10"/>
                    <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="Bold" TextAlignment="Center"
                               HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource HintStyle}" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <StackPanel x:Name="EmptyActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button x:Name="RetryButton" Style="{StaticResource DiagButtonStyle}" Click="Retry_Click">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="refresh" Width="14" Height="14" Margin="0,0,7,0"/>
                                <TextBlock Text="{l:T TRY AGAIN}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Selection, progress and actions, in a bar along the bottom -->
        <Border Grid.Row="3" Margin="0,4,0,0" CornerRadius="16" Background="#DB0E142C" BorderBrush="#1FFFFFFF" BorderThickness="1"
                Padding="18,10,10,10" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.55" Color="Black"/>
            </Border.Effect>
            <Grid MinHeight="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock x:Name="Status" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="Progress" Style="{StaticResource LineProgressStyle}" Margin="0,7,0,0" Maximum="100"
                                 Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel x:Name="LibraryActions" Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="{l:T CANCEL}" Style="{StaticResource SmallButtonStyle}" Height="40"
                            Visibility="Collapsed" Click="Cancel_Click"/>
                    <Button x:Name="DownloadAll" Style="{StaticResource SmallButtonStyle}" Height="40" Margin="10,0,0,0" Click="DownloadAll_Click"/>
                    <Button x:Name="DownloadSelected" Style="{StaticResource GoldButtonStyle}" Height="40" Margin="10,0,0,0" IsEnabled="False"
                            Click="DownloadSelected_Click">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="download" Width="15" Height="15" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:T DOWNLOAD SELECTED}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="InstalledActions" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Style="{StaticResource DiagButtonStyle}" Height="40" Click="AddMaps_Click">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="upload" Width="15" Height="15" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:T ADD MAPS}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="FolderButton" Style="{StaticResource SmallButtonStyle}" Height="40" Margin="10,0,0,0" Click="Folder_Click"/>
                    <Button x:Name="DeleteButton" Content="{l:T DELETE}" Style="{StaticResource DangerButtonStyle}" Height="40" Margin="10,0,0,0"
                            Visibility="Collapsed" Click="Delete_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Shown while files are dragged over the section -->
        <Border x:Name="DropOverlay" Grid.RowSpan="4" Background="#E6050814" CornerRadius="18" Visibility="Collapsed" AllowDrop="True"
                DragOver="Overlay_DragOver" DragLeave="Overlay_DragLeave" Drop="Overlay_Drop">
            <Grid IsHitTestVisible="False">
                <Rectangle Stroke="#2980FF" StrokeThickness="2" StrokeDashArray="4 3" RadiusX="18" RadiusY="18"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <c:Icon Kind="upload" Width="36" Height="36" Foreground="#7AB4FF" Margin="0,0,0,12"/>
                    <TextBlock Text="{l:T DROP TO INSTALL}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{l:T Map .zip files and map folders are copied to your Maps folder.}" Style="{StaticResource HintStyle}"
                               TextAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
