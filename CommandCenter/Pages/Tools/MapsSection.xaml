<UserControl x:Class="CommandCenter.Pages.Tools.MapsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:CommandCenter.Services"
             AllowDrop="True" DragEnter="Section_DragEnter">
    <UserControl.Resources>
        <!-- One map: preview with a tick box, then the name and what it holds -->
        <DataTemplate x:Key="TileTemplate">
            <Border x:Name="Tile" Width="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Margin="0,0,8,8" Background="#01031A" BorderBrush="#2A2A55" BorderThickness="1"
                    Cursor="{Binding Cursor}" ToolTip="{Binding Tip}"
                    MouseLeftButtonUp="Tile_Click" Loaded="Tile_Loaded" Unloaded="Tile_Unloaded">
                <StackPanel>
                    <Grid Height="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Background="#00020F" ClipToBounds="True">
                        <Image Source="{Binding Preview}" Stretch="UniformToFill" Opacity="{Binding ImageOpacity}"
                               FlowDirection="LeftToRight" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{l:T NO PREVIEW}" FontSize="9" FontWeight="Bold" Foreground="#404070"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoPreviewVisibility}"/>
                        <Border x:Name="Box" Width="16" Height="16" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="#CC01031A" BorderBrush="#8888AA" BorderThickness="1" Visibility="{Binding CheckVisibility}">
                            <Path x:Name="Mark" Data="M2.5,7 L5.5,10 L11.5,3.5" Stroke="White" StrokeThickness="2"
                                  FlowDirection="LeftToRight" Visibility="Collapsed"/>
                        </Border>
                        <Border Margin="6" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="#E6071F0C" BorderBrush="#55CC55" BorderThickness="1" Visibility="{Binding InstalledVisibility}">
                            <TextBlock Text="{l:T INSTALLED}" FontSize="9" FontWeight="Bold" Foreground="#55CC55"/>
                        </Border>
                    </Grid>
                    <StackPanel Margin="7,5,7,7">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource NameTextStyle}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#8888AA" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="#404070"/>
                </Trigger>
                <DataTrigger Binding="{Binding Checked}" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="#2980FF"/>
                    <Setter TargetName="Tile" Property="Background" Value="#040C52"/>
                    <Setter TargetName="Box" Property="Background" Value="#2980FF"/>
                    <Setter TargetName="Box" Property="BorderBrush" Value="#2980FF"/>
                    <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A row of tiles; the rows are virtualized, so only the rows on screen exist -->
        <DataTemplate x:Key="RowTemplate">
            <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource TileTemplate}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- Thin progress line under the status text -->
        <Style x:Key="LineProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#2A2A55"/>
                            <Border x:Name="PART_Indicator" Background="#2980FF" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DiagButtonStyle}">
            <Setter Property="BorderBrush" Value="#FF4444"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title, player count and search -->
        <DockPanel LastChildFill="False">
            <TextBlock Text="{l:T MAP LIBRARY}" Style="{StaticResource SectionHeaderStyle}" DockPanel.Dock="Left"/>
            <Grid DockPanel.Dock="Right" Margin="10,0,0,0">
                <TextBox x:Name="Search" Width="180" Style="{StaticResource TextBoxStyle}" TextChanged="Search_Changed"/>
                <TextBlock x:Name="SearchHint" Text="{l:T Search maps}" Foreground="#606080" FontSize="13" Margin="11,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <ComboBox x:Name="PlayersFilter" DockPanel.Dock="Right" Width="130" Height="32" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="{l:T All players}"/>
                <ComboBoxItem Content="{l:T 2 players}"/>
                <ComboBoxItem Content="{l:T 3–4 players}"/>
                <ComboBoxItem Content="{l:T 5–6 players}"/>
                <ComboBoxItem Content="{l:T 7–8 players}"/>
            </ComboBox>
        </DockPanel>

        <!-- Library or installed maps; where the library comes from -->
        <DockPanel Grid.Row="1" Margin="0,10,0,8" LastChildFill="False">
            <RadioButton x:Name="TabLibrary" GroupName="MapTabs" Style="{StaticResource SubTabStyle}" IsChecked="True"
                         DockPanel.Dock="Left" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabInstalled" GroupName="MapTabs" Style="{StaticResource SubTabStyle}"
                         DockPanel.Dock="Left" Checked="Tab_Checked"/>
            <TextBlock x:Name="Summary" DockPanel.Dock="Right" Foreground="#8888AA" FontSize="12" Margin="16,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Tiles -->
        <Border Grid.Row="2" Style="{StaticResource ResultBoxStyle}" Padding="10,10,4,4">
            <Grid>
                <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource RowTemplate}" Focusable="False"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                              SizeChanged="Rows_SizeChanged">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer x:Name="Scroller" CanContentScroll="True" Focusable="False"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                            Margin="0,0,6,6" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyTitle" FontSize="14" FontWeight="SemiBold" TextAlignment="Center"
                               HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource HintStyle}" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <StackPanel x:Name="EmptyActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="RetryButton" Content="{l:T TRY AGAIN}" Style="{StaticResource DiagButtonStyle}" Click="Retry_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Selection, progress and actions -->
        <Grid Grid.Row="3" Margin="0,10,0,0" MinHeight="34">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock x:Name="Status" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="Progress" Style="{StaticResource LineProgressStyle}" Margin="0,6,0,0" Maximum="100"
                             Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel x:Name="LibraryActions" Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="{l:T CANCEL}" Style="{StaticResource DiagButtonStyle}"
                        Visibility="Collapsed" Click="Cancel_Click"/>
                <Button x:Name="DownloadAll" Style="{StaticResource DiagButtonStyle}" Margin="10,0,0,0" Click="DownloadAll_Click"/>
                <Button x:Name="DownloadSelected" Content="{l:T DOWNLOAD SELECTED}" Style="{StaticResource GoldButtonStyle}"
                        Margin="10,0,0,0" IsEnabled="False" Click="DownloadSelected_Click"/>
            </StackPanel>
            <StackPanel x:Name="InstalledActions" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                <Button Content="{l:T ADD MAPS}" Style="{StaticResource DiagButtonStyle}" Click="AddMaps_Click"/>
                <Button x:Name="FolderButton" Style="{StaticResource DiagButtonStyle}" Margin="10,0,0,0" Click="Folder_Click"/>
                <Button x:Name="DeleteButton" Content="{l:T DELETE}" Style="{StaticResource DangerButtonStyle}" Margin="10,0,0,0"
                        Visibility="Collapsed" Click="Delete_Click"/>
            </StackPanel>
        </Grid>

        <!-- Shown while files are dragged over the section -->
        <Border x:Name="DropOverlay" Grid.RowSpan="4" Background="#E601031A" Visibility="Collapsed" AllowDrop="True"
                DragOver="Overlay_DragOver" DragLeave="Overlay_DragLeave" Drop="Overlay_Drop">
            <Grid IsHitTestVisible="False">
                <Rectangle Stroke="#2980FF" StrokeThickness="2" StrokeDashArray="4 3"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="{l:T DROP TO INSTALL}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{l:T Map .zip files and map folders are copied to your Maps folder.}" Style="{StaticResource HintStyle}"
                               TextAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
