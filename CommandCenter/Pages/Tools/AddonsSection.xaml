<UserControl x:Class="CommandCenter.Pages.Tools.AddonsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:CommandCenter.Services">
    <UserControl.Resources>
        <!-- One control bar to choose: flat box, blue when chosen like the sidebar tabs -->
        <Style x:Key="BarChoiceStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="ControlBar"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="#07091C" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="12,10,12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,10,0">
                                    <Ellipse x:Name="Ring" Stroke="#606080" StrokeThickness="1.5"/>
                                    <Ellipse x:Name="Mark" Width="6" Height="6" Fill="#2980FF" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#2980FF"/>
                                <Setter TargetName="Card" Property="Background" Value="#262980FF"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="#2980FF"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="ChoiceText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#A7AECB"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="InstalledMark" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#55CC55"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock Text="{l:T ADD-ONS}" Style="{StaticResource SectionHeaderStyle}" DockPanel.Dock="Left"/>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{l:T CONTROL BAR}" Style="{StaticResource GroupLabelStyle}" Margin="0,12,0,8"/>

        <!-- Control bar -->
        <ScrollViewer x:Name="BarsView" Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="BarsPanel" Margin="0,0,8,0" SizeChanged="BarsPanel_SizeChanged">
                <Border BorderBrush="#1FFFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                    <Grid x:Name="CompareBox" ClipToBounds="True" Cursor="SizeWE" Background="Black" FlowDirection="LeftToRight"
                          Height="120" MouseLeftButtonDown="Compare_Down" MouseMove="Compare_Move" MouseLeftButtonUp="Compare_Up"
                          LostMouseCapture="Compare_LostCapture" SizeChanged="Compare_SizeChanged">
                        <Image x:Name="Before" Stretch="Fill"/>
                        <Image x:Name="After" Stretch="Fill"/>
                        <Rectangle x:Name="Divider" Width="2" HorizontalAlignment="Left" Fill="#2980FF"/>
                        <Border x:Name="Handle" Width="8" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#2980FF"/>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="6,2" Background="#D901031A">
                            <TextBlock x:Name="BeforeLabel" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <Border x:Name="AfterTag" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="6,2" Background="#D901031A">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#5BA4FF" Text="CONTROL BAR PRO"/>
                        </Border>
                    </Grid>
                </Border>
                <TextBlock x:Name="CompareNote" Foreground="#A7AECB" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,12"/>

                <!-- Bar archives that are not offered here, added by hand -->
                <Border x:Name="OtherNotice" BorderBrush="#1FFFFFFF" BorderThickness="1" Background="#07091C" Padding="12,9" Margin="0,0,0,10"
                        Visibility="Collapsed">
                    <DockPanel>
                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="#FFAA00" VerticalAlignment="Top" Margin="0,5,10,0"/>
                        <StackPanel>
                            <TextBlock x:Name="OtherTitle" Text="{l:T Another control bar is installed}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OtherDetail" FontSize="11.5" Foreground="#A8A8C8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="ChoiceOriginal" Grid.Column="0" Style="{StaticResource BarChoiceStyle}" Checked="Choice_Checked">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="OriginalInstalled" DockPanel.Dock="Right" Text="{l:T INSTALLED}" Style="{StaticResource InstalledMark}"/>
                                <TextBlock Text="{l:T Original}" Style="{StaticResource ChoiceTitle}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource ChoiceText}">
                                <TextBlock.Text><l:T Text="The game's own control bar"/></TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ChoicePro" Grid.Column="2" Style="{StaticResource BarChoiceStyle}" Checked="Choice_Checked">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="ProInstalled" DockPanel.Dock="Right" Text="{l:T INSTALLED}" Style="{StaticResource InstalledMark}"/>
                                <TextBlock Text="Control Bar Pro" Style="{StaticResource ChoiceTitle}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{l:T Larger, cleaner bar by TheSuperHackers · v1.2}" Style="{StaticResource ChoiceText}"/>
                            <ComboBox x:Name="Resolution" Height="26" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Left" MinWidth="130"
                                      SelectionChanged="Resolution_Changed" ToolTip="{l:T Pick the size that matches your game resolution}"/>
                        </StackPanel>
                    </RadioButton>
                </Grid>

                <TextBlock Text="{l:T SAFETY}" Style="{StaticResource GroupLabelStyle}" Margin="0,18,0,6"/>
                <StackPanel x:Name="SafetyList" Margin="0,0,0,4"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Control bar: what Apply will do -->
        <DockPanel x:Name="BarsFooter" Grid.Row="3" Margin="0,10,0,0">
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="{l:T APPLY}" Style="{StaticResource GoldButtonStyle}" Margin="10,0,0,0"
                    MinWidth="90" Click="Apply_Click"/>
            <Button x:Name="DiscardButton" DockPanel.Dock="Right" Content="{l:T DISCARD}" Style="{StaticResource DiagButtonStyle}" Margin="10,0,0,0"
                    Visibility="Collapsed" Click="Discard_Click"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ChangeText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ChangeDetail" FontSize="11.5" Foreground="#A7AECB" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
