<UserControl x:Class="CommandCenter.Pages.Tools.HealthSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CommandCenter.Controls"
             xmlns:l="clr-namespace:CommandCenter.Services">
    <UserControl.Resources>
        <Style x:Key="Numeral" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontStretch" Value="Condensed"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button x:Name="FixAllButton" DockPanel.Dock="Right" Style="{StaticResource GoldButtonStyle}" Height="40" Margin="10,0,0,0"
                    VerticalAlignment="Bottom" Visibility="Collapsed" Click="FixAll_Click">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Kind="bolt" Width="15" Height="15" Margin="0,0,8,0"/>
                    <TextBlock x:Name="FixAllText" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="CheckButton" DockPanel.Dock="Right" Style="{StaticResource SmallButtonStyle}" Height="40" VerticalAlignment="Bottom"
                    Click="Check_Click">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Kind="refresh" Width="15" Height="15" Margin="0,0,8,0"/>
                    <TextBlock Text="{l:T CHECK AGAIN}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="{l:T HEALTH}" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock x:Name="Summary" Style="{StaticResource HintStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- How much of the game passed, and what is left -->
            <Border Style="{StaticResource GlassCardStyle}" CornerRadius="18" Padding="20,22" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Width="140" Height="140" FlowDirection="LeftToRight">
                        <Ellipse Stroke="#14FFFFFF" StrokeThickness="12"/>
                        <Ellipse x:Name="Ring" Stroke="#52D273" StrokeThickness="12" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="PercentText" Style="{StaticResource Numeral}" FontSize="38" HorizontalAlignment="Center" Text="—"/>
                            <TextBlock x:Name="RingLabel" FontSize="12" Foreground="#A7AECB" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                        </Grid.RowDefinitions>
                        <Border Width="9" Height="9" CornerRadius="3" Background="#52D273" Margin="0,0,9,0"/>
                        <TextBlock Grid.Column="1" Text="{l:T Passed}" FontSize="13" Foreground="#D5D9EA" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="PassedCount" Style="{StaticResource Numeral}" FontSize="17" VerticalAlignment="Center"/>
                        <Border Grid.Row="1" Width="9" Height="9" CornerRadius="3" Background="#FFB020" Margin="0,0,9,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{l:T Warnings}" FontSize="13" Foreground="#D5D9EA" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="WarningCount" Style="{StaticResource Numeral}" FontSize="17" VerticalAlignment="Center"/>
                        <Border Grid.Row="2" Width="9" Height="9" CornerRadius="3" Background="#FF6B6B" Margin="0,0,9,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{l:T Problems}" FontSize="13" Foreground="#D5D9EA" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="ProblemCount" Style="{StaticResource Numeral}" FontSize="17" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="#14FFFFFF" Margin="0,16,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <c:Icon Kind="clock" Width="13" Height="13" Foreground="#A7AECB" Margin="0,0,6,0"/>
                        <TextBlock x:Name="CheckedAt" Foreground="#A7AECB" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="TabChecks" GroupName="HealthViews" Style="{StaticResource SubTabStyle}" IsChecked="True"
                                 Checked="View_Checked"/>
                    <RadioButton x:Name="TabHistory" GroupName="HealthViews" Style="{StaticResource SubTabStyle}"
                                 Checked="View_Checked"/>
                </StackPanel>
                <Grid>
                    <ScrollViewer x:Name="ChecksView" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel x:Name="ChecksList" Margin="0,0,8,0"/>
                    </ScrollViewer>
                    <Border x:Name="HistoryView" Style="{StaticResource ResultBoxStyle}" Padding="14,12,6,12" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel x:Name="HistoryList" Margin="0,0,8,0"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButtonStyle}" Margin="10,0,0,0" Click="Report_Click">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Kind="copy" Width="14" Height="14" Margin="0,0,8,0"/>
                    <TextBlock Text="{l:T COPY SUPPORT REPORT}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BackupsButton" DockPanel.Dock="Right" Style="{StaticResource SmallButtonStyle}" Margin="10,0,0,0"
                    Visibility="Collapsed" Click="Backups_Click">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Kind="folder" Width="14" Height="14" Margin="0,0,8,0"/>
                    <TextBlock Text="{l:T OPEN BACKUPS}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="FooterHint" Foreground="#A7AECB" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
