  "{0} archives match Zero Hour 1.04": { "one": "أرشيف واحد يطابق Zero Hour 1.04", "two": "أرشيفان يطابقان Zero Hour 1.04", "few": "{0} أرشيفات تطابق Zero Hour 1.04", "many": "{0} أرشيفًا يطابق Zero Hour 1.04", "other": "{0} أرشيف يطابق Zero Hour 1.04" },
