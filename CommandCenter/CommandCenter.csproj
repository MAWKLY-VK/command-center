<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CommandCenter</AssemblyName>
    <RootNamespace>CommandCenter</RootNamespace>
    <Version>0.2.1</Version>
    <Product>Command Center</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 32-bit on the .NET 10 Desktop Runtime (x86) that the Generals Online launcher installs and runs on itself,
         so the program stays a few megabytes instead of carrying its own copy of .NET -->
    <PlatformTarget>x86</PlatformTarget>
    <RollForward>Major</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.jpg" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
    <EmbeddedResource Include="Localization\*.json" Exclude="Localization\pending-*.json" LogicalName="Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Data\game-files.json" LogicalName="GameFiles.json" />
  </ItemGroup>

</Project>
