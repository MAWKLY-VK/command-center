* text=auto
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.md text eol=lf
*.jpg binary
*.png binary
# Test data sets keep their exact bytes (backups.json records file hashes)
tools/capture-data/** -text
# Signed files keep the exact bytes GitHub serves, so their signatures match on every PC
go-profile.json text eol=lf
*.sig -text
