<!--
    Command Center's controls in the plan 3-c design, built only from Tokens.xaml. Pages that have moved to the new look
    use these; GoStyles.xaml keeps the styles of the pages that have not moved yet.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <Thickness x:Key="Pad.Tab">12,0</Thickness>
    <Thickness x:Key="Pad.Toast">16,12</Thickness>
    <Thickness x:Key="Pad.QuietButton">12,0</Thickness>
    <Thickness x:Key="Pad.Badge">6,0</Thickness>

    <!-- The window's tabs, and its Settings and Help links, which are tabs too: quiet text, the selected one in primary
         text with the gold line under it (gold on edges only) -->
    <Style x:Key="FrameTabStyle" TargetType="RadioButton">
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="GroupName" Value="FrameTabs"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="{StaticResource Pad.Tab}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        <Border x:Name="Line" Height="2" VerticalAlignment="Bottom" Margin="{TemplateBinding Padding}"
                                Background="{StaticResource Accent}" Visibility="Hidden"/>
                        <Border x:Name="Ring" BorderBrush="{StaticResource Focus}" BorderThickness="{StaticResource Line.Focus}"
                                CornerRadius="{StaticResource Radius.Small}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                            <Setter TargetName="Line" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A tab's label: the text follows the tab's colour -->
    <Style x:Key="FrameTabLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
    </Style>

    <!-- Minimize and close, and the small close button of a message -->
    <Style x:Key="WindowButtonStyle" TargetType="Button">
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="Transparent" CornerRadius="{StaticResource Radius.Small}"
                            BorderBrush="{StaticResource Focus}" BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Bg.Raised}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Bg.Panel}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Line.Focus}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A secondary action in a message or panel: a thin border, never gold -->
    <Style x:Key="QuietButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="MinHeight" Value="{StaticResource Target.Min}"/>
        <Setter Property="Padding" Value="{StaticResource Pad.QuietButton}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="Transparent" BorderBrush="{StaticResource Border}"
                            BorderThickness="{StaticResource Line.Thin}" CornerRadius="{StaticResource Radius.Small}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Bg.Raised}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Bg.Panel}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Focus}"/>
                            <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Line.Focus}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Health's count next to its tab: the state's colour, the number in the data face -->
    <Style x:Key="CountBadgeStyle" TargetType="Border">
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="{StaticResource Pad.Badge}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource Warning}"/>
    </Style>

    <Style x:Key="CountBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Data}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Bg.Window}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The short message after an action: a raised panel with a thin border, the border in the problem colour for an
         error -->
    <Style x:Key="ToastStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg.Raised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Line.Thin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
        <Setter Property="Padding" Value="{StaticResource Pad.Toast}"/>
    </Style>

    <Style x:Key="ToastTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- The one-time notice's Arabic paragraph: right to left, drawn by Segoe UI through the text font's fallback -->
    <Style x:Key="ToastArabicTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ToastTextStyle}">
        <Setter Property="FlowDirection" Value="RightToLeft"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- The program's name at the top left -->
    <Style x:Key="BrandStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Heading}"/>
        <Setter Property="FontStretch" Value="{StaticResource Font.Heading.Stretch}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Title}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
