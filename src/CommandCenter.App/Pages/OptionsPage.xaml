<Page
    x:Class="CommandCenter.Pages.OptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CommandCenter.Controls"
    Background="Transparent">

    <Page.Resources>
        <!-- The shared sidebar tab, a little shorter so all sections fit -->
        <Style x:Key="NavTabStyle" TargetType="RadioButton" BasedOn="{StaticResource NavTabStyle}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>


        <!-- Numeric TextBox style -->
        <Style x:Key="NumericBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#D90D1328"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#2980FF"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderStyle}">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Field label style -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="220"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- The sections, Command Center's own first, then Generals Online's -->
        <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="40,24,0,24" Padding="0,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <RadioButton x:Name="rbGame" GroupName="OptionsTabs" Style="{StaticResource SideTabStyle}" IsChecked="True" Checked="Tab_Checked">
                    <TextBlock Text="Game folder" Style="{StaticResource ButtonLabelStyle}"/>
                </RadioButton>
                <RadioButton x:Name="rbAppearance" GroupName="OptionsTabs" Style="{StaticResource SideTabStyle}" Checked="Tab_Checked">
                    <TextBlock Text="Appearance" Style="{StaticResource ButtonLabelStyle}"/>
                </RadioButton>
                <RadioButton x:Name="rbAddons" GroupName="OptionsTabs" Style="{StaticResource SideTabStyle}" Checked="Tab_Checked">
                    <TextBlock Text="Add-ons" Style="{StaticResource ButtonLabelStyle}"/>
                </RadioButton>
                <RadioButton x:Name="rbCamera" GroupName="OptionsTabs" Style="{StaticResource SideTabStyle}" Checked="Tab_Checked">
                    <TextBlock Text="Camera" Style="{StaticResource ButtonLabelStyle}"/>
                </RadioButton>
                <RadioButton x:Name="rbChat" GroupName="OptionsTabs" Style="{StaticResource SideTabStyle}" Checked="Tab_Checked">
                    <TextBlock Text="Chat" Style="{StaticResource ButtonLabelStyle}"/>
                </RadioButton>
                <RadioButton x:Name="rbInput" GroupName="OptionsTabs" Style="{StaticResource SideTabStyle}" Checked="Tab_Checked">
                    <TextBlock Text="Input" Style="{StaticResource ButtonLabelStyle}"/>
                </RadioButton>
                <RadioButton x:Name="rbGraphics" GroupName="OptionsTabs" Style="{StaticResource SideTabStyle}" Checked="Tab_Checked">
                    <TextBlock Text="Graphics" Style="{StaticResource ButtonLabelStyle}"/>
                </RadioButton>
                <RadioButton x:Name="rbSocial" GroupName="OptionsTabs" Style="{StaticResource SideTabStyle}" Checked="Tab_Checked">
                    <TextBlock Text="Social" Style="{StaticResource ButtonLabelStyle}"/>
                </RadioButton>
                <RadioButton x:Name="rbNetwork" GroupName="OptionsTabs" Style="{StaticResource SideTabStyle}" Checked="Tab_Checked">
                    <TextBlock Text="Network" Style="{StaticResource ButtonLabelStyle}"/>
                </RadioButton>
                <RadioButton x:Name="rbDataPacks" GroupName="OptionsTabs" Style="{StaticResource SideTabStyle}" Checked="Tab_Checked">
                    <TextBlock Text="Data packs" Style="{StaticResource ButtonLabelStyle}"/>
                </RadioButton>
                <RadioButton x:Name="rbPlugins" GroupName="OptionsTabs" Style="{StaticResource SideTabStyle}" Checked="Tab_Checked">
                    <TextBlock Text="Plugins" Style="{StaticResource ButtonLabelStyle}"/>
                </RadioButton>
                <RadioButton x:Name="rbLauncher" GroupName="OptionsTabs" Style="{StaticResource SideTabStyle}" Checked="Tab_Checked">
                    <TextBlock Text="Launcher" Style="{StaticResource ButtonLabelStyle}"/>
                </RadioButton>
            </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="1" x:Name="btnBack" Style="{StaticResource QuietButtonStyle}" Margin="16,8,16,8" Click="BtnBack_Click">
                <TextBlock Text="Save and go back" Style="{StaticResource ButtonLabelStyle}"/>
            </Button>
        </Grid>
        </Border>

        <!-- Content area -->
        <ScrollViewer Grid.Column="1" Padding="28,14,40,22" VerticalScrollBarVisibility="Auto"
                      Background="Transparent">

            <!-- All panels overlap in the same cell — only one visible at a time -->
            <Grid>
                <!-- Game folder: which Zero Hour is played, where that came from, and where the game keeps its data -->
                <Grid x:Name="PanelGame" Visibility="Visible" DataContext="{Binding GameFolder}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="760"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Game folder" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource PageIntroStyle}"/>
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource QuietButtonStyle}" Margin="16,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding ChangeFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon Kind="folder" Width="16" Height="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="Change folder" Style="{StaticResource ButtonLabelStyle}"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Zero Hour" Style="{StaticResource PanelTitleStyle}"/>
                                        <Border Style="{StaticResource TagStyle}" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Source}" Style="{StaticResource TagTextStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Folder}" Style="{StaticResource DataTextStyle}" TextWrapping="Wrap" TextTrimming="None" Margin="{StaticResource Gap.Text}"/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Found}" Margin="{StaticResource Gap.Actions}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                            <c:Icon Kind="check-circle" Width="16" Height="16" Margin="0,0,8,0" Foreground="{StaticResource Success}"/>
                                            <TextBlock Text="{Binding}" Style="{StaticResource StateTextStyle}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Missing}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Text}">
                                            <c:Icon Kind="alert" Width="16" Height="16" Margin="0,0,8,0" Foreground="{StaticResource Problem}"/>
                                            <TextBlock Text="{Binding}" Style="{StaticResource StateTextStyle}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource PanelDividerStyle}"/>

                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource QuietButtonStyle}" Margin="16,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding OpenDataFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon Kind="external" Width="16" Height="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="Open folder" Style="{StaticResource ButtonLabelStyle}"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="Settings, maps and replays" Style="{StaticResource PanelTitleStyle}"/>
                                    <TextBlock Text="{Binding DataFolder}" Style="{StaticResource DataTextStyle}" TextWrapping="Wrap" TextTrimming="None" Margin="{StaticResource Gap.Text}"/>
                                    <TextBlock Text="Where the game itself keeps them, also when an installer moved them." Style="{StaticResource PanelTextStyle}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Grid>

                <!-- CAMERA -->
                <StackPanel x:Name="PanelCamera" Visibility="Collapsed">
                    <TextBlock Text="CAMERA" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Maximum Camera Height *"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtMaxCameraHeight"
                                 Style="{StaticResource NumericBoxStyle}" Text="310"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="* Only applies when you are the lobby host"
                                   Foreground="#888888" FontSize="11"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Minimum Camera Height"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtMinCameraHeight"
                                 Style="{StaticResource NumericBoxStyle}" Text="210"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Camera Movement Speed (%)"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtCameraMovementSpeed"
                                 Style="{StaticResource NumericBoxStyle}" Text="100"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>
                    </Grid>
                </StackPanel>

                <!-- CHAT -->
                <StackPanel x:Name="PanelChat" Visibility="Collapsed">
                    <TextBlock Text="CHAT" Style="{StaticResource SectionHeaderStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Fade Out Duration (Seconds)"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="txtChatDuration"
                                 Style="{StaticResource NumericBoxStyle}" Text="30"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>
                    </StackPanel>
                </StackPanel>

                <!-- INPUT -->
                <StackPanel x:Name="PanelInput" Visibility="Collapsed">
                    <TextBlock Text="INPUT" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>
                        <CheckBox Grid.Row="0" Grid.Column="0" x:Name="chkCursorLockWindowed"
                                  Content="Cursor Lock (Windowed)"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" x:Name="chkCursorLockFullscreen"
                                  Content="Cursor Lock (Fullscreen)"/>
                        <CheckBox Grid.Row="1" Grid.Column="0" x:Name="chkEdgeScrollingWindowed"
                                  Content="Edge Scrolling (Windowed)"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" x:Name="chkEdgeScrollingFullscreen"
                                  Content="Edge Scrolling (Fullscreen)"/>
                    </Grid>
                </StackPanel>

                <!-- GRAPHICS -->
                <StackPanel x:Name="PanelGraphics" Visibility="Collapsed" Margin="0,0,0,0">
                    <TextBlock Text="GRAPHICS" Style="{StaticResource SectionHeaderStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <CheckBox x:Name="chkLimitFramerate" Content="Limit Framerate"
                                  Checked="ChkLimitFramerate_Changed"
                                  Unchecked="ChkLimitFramerate_Changed"
                                  VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBox x:Name="txtFPSLimit"
                                 Style="{StaticResource NumericBoxStyle}" Text="60"
                                 IsEnabled="False"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>
                        <TextBlock Text="FPS" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="chkStatsOverlay" Content="Show Statistics Overlay"/>
                    <CheckBox x:Name="chkWindowed" Content="Windowed" Margin="0,8,0,4"
                              Checked="ChkWindowed_Changed"
                              Unchecked="ChkWindowed_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Windowed Resolution" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="cmbWindowedResolution" Width="160" IsEnabled="False"
                                  Background="#0F1426" Foreground="White" BorderBrush="#2E3550"/>
                    </StackPanel>
                </StackPanel>

                <!-- SOCIAL -->
                <StackPanel x:Name="PanelSocial" Visibility="Collapsed">
                    <TextBlock Text="NOTIFICATIONS" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="In-Game"
                                   Foreground="#888888" FontSize="11" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="In Menus"
                                   Foreground="#888888" FontSize="11" Margin="0,0,0,6"/>

                        <CheckBox Grid.Row="1" Grid.Column="0" x:Name="chkFriendOnlineInGame"
                                  Content="Friend Comes Online (In-Game)"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" x:Name="chkFriendOnlineInMenus"
                                  Content="Friend Comes Online (In Menus)"/>
                        <CheckBox Grid.Row="2" Grid.Column="0" x:Name="chkFriendOfflineInGame"
                                  Content="Friend Goes Offline (In-Game)"/>
                        <CheckBox Grid.Row="2" Grid.Column="1" x:Name="chkFriendOfflineInMenus"
                                  Content="Friend Goes Offline (In Menus)"/>
                        <CheckBox Grid.Row="3" Grid.Column="0" x:Name="chkFriendRequestInGame"
                                  Content="Incoming Friend Request (In-Game)"/>
                        <CheckBox Grid.Row="3" Grid.Column="1" x:Name="chkFriendRequestInMenus"
                                  Content="Incoming Friend Request (In Menus)"/>
                        <CheckBox Grid.Row="4" Grid.Column="0" x:Name="chkFriendAcceptedInGame"
                                  Content="Outgoing Request Accepted (In-Game)"/>
                        <CheckBox Grid.Row="4" Grid.Column="1" x:Name="chkFriendAcceptedInMenus"
                                  Content="Outgoing Request Accepted (In Menus)"/>
                    </Grid>
                </StackPanel>

                <!-- NETWORK -->
                <StackPanel x:Name="PanelNetwork" Visibility="Collapsed">
                    <TextBlock Text="NETWORK" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock
                        Text="⚠ These are advanced options that you should not change unless you know what you are doing."
                        Foreground="#FF6060" FontWeight="Bold" FontSize="12"
                        TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="HTTP Version" Style="{StaticResource FieldLabelStyle}" MinWidth="100"/>
                        <ComboBox x:Name="cmbHTTPVersion" Width="200" SelectedIndex="0"
                                  Background="#0F1426" Foreground="White" BorderBrush="#2E3550">
                            <ComboBoxItem Content="Automatic"/>
                            <ComboBoxItem Content="1.0"/>
                            <ComboBoxItem Content="1.1"/>
                            <ComboBoxItem Content="2.0"/>
                            <ComboBoxItem Content="3.0"/>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="chkAlternativeEndpoint" Content="Use Alternative Endpoints"/>

                    <!-- ── DIAGNOSTICS ──────────────────────────────────────── -->
                    <Rectangle Height="1" Fill="#252550" Margin="0,16,0,16"/>
                    <TextBlock Text="DIAGNOSTICS" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="btnRunDiagnostics"
                                Content="▶  RUN DIAGNOSTICS"
                                Style="{StaticResource DiagButtonStyle}"
                                Margin="0,0,10,0"
                                Click="BtnRunDiagnostics_Click"/>
                        <Button x:Name="btnCopyDiag"
                                Content="⎘  COPY"
                                Style="{StaticResource DiagButtonStyle}"
                                IsEnabled="False"
                                Click="BtnCopyDiag_Click"/>
                    </StackPanel>

                    <!-- Results panel — hidden until first run -->
                    <Border x:Name="panelDiagResults" Visibility="Collapsed"
                            Background="#07091C" BorderBrush="#1FFFFFFF" BorderThickness="1"
                            Padding="14,12,14,14" Margin="0,0,0,10">
                        <StackPanel>

                            <!-- Internet baseline -->
                            <TextBlock Text="INTERNET" Foreground="#40FFFFFF" FontSize="10"
                                       FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotGeo" Width="8" Height="8" Fill="#40FFFFFF"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="Your Country" Foreground="#A7AECB"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valGeo" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <Ellipse x:Name="dotCF" Width="8" Height="8" Fill="#40FFFFFF"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="Cloudflare" Foreground="#A7AECB"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valCF" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Game server -->
                            <TextBlock Text="GAME SERVER" Foreground="#40FFFFFF" FontSize="10"
                                       FontWeight="Bold" FontFamily="Segoe UI" Margin="0,10,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotDns" Width="8" Height="8" Fill="#40FFFFFF"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="DNS Resolution" Foreground="#A7AECB"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valDns" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotPing" Width="8" Height="8" Fill="#40FFFFFF"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="Server Ping  (ICMP)" Foreground="#A7AECB"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valPing" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotProto" Width="8" Height="8" Fill="#40FFFFFF"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="Protocol" Foreground="#A7AECB"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valProto" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotHttp" Width="8" Height="8" Fill="#40FFFFFF"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="HTTP Latency" Foreground="#A7AECB"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valHttp" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <Ellipse x:Name="dotServer" Width="8" Height="8" Fill="#40FFFFFF"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="Server Status" Foreground="#A7AECB"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valServer" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Connectivity -->
                            <TextBlock Text="CONNECTIVITY" Foreground="#40FFFFFF" FontSize="10"
                                       FontWeight="Bold" FontFamily="Segoe UI" Margin="0,10,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotCdn" Width="8" Height="8" Fill="#40FFFFFF"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="CDN  cdn.playgenerals.online" Foreground="#A7AECB"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valCdn" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotStun" Width="8" Height="8" Fill="#40FFFFFF"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="STUN  stun.playgenerals.online" Foreground="#A7AECB"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valStun" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="dotTurn" Width="8" Height="8" Fill="#40FFFFFF"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="TURN  turn.playgenerals.online" Foreground="#A7AECB"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valTurn" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <Ellipse x:Name="dotNat" Width="8" Height="8" Fill="#40FFFFFF"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="NAT Type" Foreground="#A7AECB"
                                           FontSize="12" VerticalAlignment="Center" MinWidth="210"/>
                                <TextBlock x:Name="valNat" Text="—" Foreground="#606080"
                                           FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- Run log — last 10 results -->
                    <TextBlock Text="LOG" Foreground="#40FFFFFF" FontSize="10"
                               FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                    <Border Background="#07091C" BorderBrush="#1FFFFFFF" BorderThickness="1"
                            Padding="10,8" MaxHeight="130">
                        <ScrollViewer x:Name="diagLogScroller" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="diagLog"/>
                        </ScrollViewer>
                    </Border>

                </StackPanel>

                <!-- DATA PACKS -->
                <StackPanel x:Name="PanelDataPacks" Visibility="Collapsed">
                    <TextBlock Text="DATA PACKS" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="We recommend enabling this if you are playing the unmodified game, or DISABLING it if you are playing with a modification."
                               Foreground="#E0A030" FontSize="12" TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <CheckBox x:Name="chkUseCommunityDataPatch" Content="Use Community Data Patch"/>
                </StackPanel>

                <!-- PLUGINS -->
                <StackPanel x:Name="PanelPlugins" Visibility="Collapsed">
                    <TextBlock Text="PLUGINS" Style="{StaticResource SectionHeaderStyle}"/>
                    
                    <!-- ANTICHEAT -->
                    <TextBlock Text="ANTICHEAT" Foreground="#A7AECB" FontSize="12" FontWeight="Bold" 
                               Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Plugin" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="cmbAnticheatPlugin" Width="250"
                                  Background="#0F1426" Foreground="White" BorderBrush="#2E3550"
                                  SelectionChanged="CmbAnticheatPlugin_SelectionChanged"/>
                    </StackPanel>
                    <TextBlock Text="The game loads the anti-cheat chosen here when it starts. If it does not start with one, choose the other."
                               Foreground="#A7AECB" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    
                    <!-- Configuration Details -->
                    <TextBlock Text="CONFIGURATION" Foreground="#A7AECB" FontSize="12" FontWeight="Bold" 
                               Margin="0,0,0,8"/>
                    <Border Background="#07091C" BorderBrush="#1FFFFFFF" BorderThickness="1"
                            Padding="14,12" MaxHeight="400" Margin="0,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="configDetailsPanel">
                                <TextBlock Text="(No plugin selected)" Foreground="#A0A0C0" FontSize="11"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- Appearance: Home's picture, animation effects and interface sounds -->
                <Grid x:Name="PanelAppearance" Visibility="Collapsed" DataContext="{Binding Appearance}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="760"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="How Command Center looks and sounds. The game itself is not changed." Style="{StaticResource PageIntroStyle}"/>
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Home picture" Style="{StaticResource PanelTitleStyle}"/>
                            <TextBlock Text="From your own game: the battle scene of the main menu, or a faction's loading screen." Style="{StaticResource PanelTextStyle}"/>
                            <ItemsControl ItemsSource="{Binding Pictures}" Margin="{StaticResource Gap.Actions}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="HomePicture" Style="{StaticResource ChoiceStyle}" IsChecked="{Binding Selected}">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource ButtonLabelStyle}"/>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource PanelDividerStyle}"/>

                            <TextBlock Text="Animation effects" Style="{StaticResource PanelTitleStyle}"/>
                            <TextBlock Text="The slow zoom of the Home picture and the short fades between pages. Following Windows uses its &quot;Show animations&quot; setting." Style="{StaticResource PanelTextStyle}"/>
                            <ItemsControl ItemsSource="{Binding Animations}" Margin="{StaticResource Gap.Actions}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="Animations" Style="{StaticResource ChoiceStyle}" IsChecked="{Binding Selected}">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource ButtonLabelStyle}"/>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource PanelDividerStyle}"/>

                            <CheckBox Style="{StaticResource CheckStyle}" IsChecked="{Binding InterfaceSounds}">
                                <TextBlock Text="Interface sounds" Style="{StaticResource ButtonLabelStyle}"/>
                            </CheckBox>
                            <TextBlock Text="The game's own click and launch sounds, read from your game." Style="{StaticResource PanelTextStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Grid>

                <!-- Add-ons: Control Bar Pro, moved here from its own tab (P5-D1) -->
                <Grid x:Name="PanelAddonsHost" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="760"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="PanelAddons" Focusable="False"/>
                </Grid>

                <!-- Launcher: Command Center's own version, the update check, and where it comes from -->
                <Grid x:Name="PanelLauncher" Visibility="Collapsed" DataContext="{Binding Launcher}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="760"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Launcher" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="Command Center updates itself when it starts; you can also check now." Style="{StaticResource PageIntroStyle}"/>
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource QuietButtonStyle}" Margin="16,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding CheckForUpdatesCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon Kind="refresh" Width="16" Height="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="Check for updates" Style="{StaticResource ButtonLabelStyle}"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Version}" Style="{StaticResource PanelTitleStyle}"/>
                                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource PanelTextStyle}" Visibility="{Binding ShowUpdateStatus, Converter={StaticResource Visible}}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource PanelDividerStyle}"/>

                            <TextBlock Text="About" Style="{StaticResource PanelTitleStyle}"/>
                            <TextBlock Style="{StaticResource PanelTextStyle}"
                                       Text="Command Center is free software under the GNU General Public License, version 3. It is based on the Generals Online Launcher by the GeneralsOnline Development Team, also under GPL-3.0. It is not made by or affiliated with Generals Online or Electronic Arts."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
