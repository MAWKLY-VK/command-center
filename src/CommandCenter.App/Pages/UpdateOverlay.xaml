<UserControl x:Class="CommandCenter.Pages.UpdateOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CommandCenter.Controls"
             Visibility="Collapsed"
             FontFamily="{StaticResource Font.Text}">

    <!-- Covers the whole window: the window hides its page and top bar under it, and the game's art shows around it
         blurred. The only ways out are installing the update or closing the window. -->
    <Grid Background="Transparent">
        <!-- The window's own close button is underneath, so the screen brings its own in the same place: the top bar's
             height and right margin -->
        <Grid Height="64" VerticalAlignment="Top">
            <Button HorizontalAlignment="Right" Margin="0,0,8,0" Style="{StaticResource WindowButtonStyle}" Click="Close_Click"
                    ToolTip="Close" AutomationProperties.Name="Close">
                <c:Icon Kind="close" Width="14" Height="14"/>
            </Button>
        </Grid>

        <Border Style="{StaticResource DialogStyle}">
            <StackPanel>
                <TextBlock Text="Update required" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="Message" Style="{StaticResource PanelTextStyle}"/>
                <TextBlock x:Name="Versions" Style="{StaticResource DataTextStyle}" Margin="{StaticResource Gap.Text}"/>

                <StackPanel x:Name="NotesBox" Margin="{StaticResource Gap.Group}">
                    <TextBlock Text="What's new" Style="{StaticResource GroupTitleStyle}"/>
                    <TextBlock x:Name="Notes" Style="{StaticResource PanelTextStyle}"/>
                </StackPanel>

                <StackPanel x:Name="ProgressBox" Margin="{StaticResource Gap.Group}" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock x:Name="Percent" DockPanel.Dock="Right" Style="{StaticResource DataTextStyle}"
                                   Foreground="{StaticResource Text.Primary}" Margin="8,0,0,0"/>
                        <TextBlock x:Name="Stage" Style="{StaticResource StateTextStyle}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <ProgressBar x:Name="Bar" Style="{StaticResource ProgressStyle}" Maximum="1" Margin="{StaticResource Gap.Text}"/>
                </StackPanel>

                <TextBlock x:Name="Error" Style="{StaticResource PanelTextStyle}" Foreground="{StaticResource Problem}"
                           Margin="{StaticResource Gap.Group}" Visibility="Collapsed"/>

                <WrapPanel Margin="{StaticResource Gap.Actions}">
                    <Button x:Name="UpdateNow" Style="{StaticResource PrimaryButtonStyle}" Margin="{StaticResource Gap.Button}"
                            Click="UpdateNow_Click" ToolTip="Download, check and install the new version (Enter)">
                        <TextBlock x:Name="UpdateNowLabel" Text="Update now" Style="{StaticResource ButtonLabelStyle}"/>
                    </Button>
                    <Button x:Name="DownloadPage" Style="{StaticResource QuietButtonStyle}" Margin="{StaticResource Gap.Button}"
                            Visibility="Collapsed" Click="DownloadPage_Click">
                        <TextBlock Text="Open download page" Style="{StaticResource ButtonLabelStyle}"/>
                    </Button>
                    <Button Style="{StaticResource QuietButtonStyle}" Margin="{StaticResource Gap.Button}" Click="Close_Click">
                        <TextBlock Text="Close" Style="{StaticResource ButtonLabelStyle}"/>
                    </Button>
                </WrapPanel>
                <TextBlock Style="{StaticResource PanelTextStyle}"
                           Text="Command Center downloads the new version, checks it and restarts by itself."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
