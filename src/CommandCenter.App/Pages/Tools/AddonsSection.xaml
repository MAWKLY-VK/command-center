<UserControl x:Class="CommandCenter.Pages.Tools.AddonsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CommandCenter.Controls"
             FontFamily="{StaticResource Font.Text}">

    <!-- Add-ons in Settings (ticket 08): the control bar, bound to AddonsViewModel; the before/after picture is the view's
         own -->
    <StackPanel x:Name="BarsPanel" SizeChanged="BarsPanel_SizeChanged">
        <TextBlock Text="Add-ons" Style="{StaticResource PageTitleStyle}"/>
        <TextBlock Text="The control bar: the game's own, or Control Bar Pro by TheSuperHackers in five sizes." Style="{StaticResource PageIntroStyle}"/>

        <!-- The labels sit above the picture, clear of the game's own text in the screenshots -->
        <DockPanel Width="{Binding ActualWidth, ElementName=CompareBox}" HorizontalAlignment="Left" Margin="0,0,0,8">
            <Border x:Name="AfterTag" DockPanel.Dock="Right" Style="{StaticResource TagStyle}">
                <TextBlock Text="Control Bar Pro" Style="{StaticResource TagTextStyle}"/>
            </Border>
            <Border Style="{StaticResource TagStyle}" HorizontalAlignment="Left">
                <TextBlock Text="Original" Style="{StaticResource TagTextStyle}"/>
            </Border>
        </DockPanel>
        <Border BorderBrush="{StaticResource Divider}" BorderThickness="{StaticResource Line.Thin}" CornerRadius="{StaticResource Radius.Medium}"
                HorizontalAlignment="Left">
            <Grid x:Name="CompareBox" ClipToBounds="True" Height="120" MouseLeftButtonDown="Compare_Down" MouseMove="Compare_Move"
                  MouseLeftButtonUp="Compare_Up" LostMouseCapture="Compare_LostCapture" SizeChanged="Compare_SizeChanged">
                <Image x:Name="Before" Stretch="Fill"/>
                <Image x:Name="After" Stretch="Fill"/>
                <Rectangle x:Name="Divider" Width="2" HorizontalAlignment="Left" Fill="{StaticResource Text.Primary}"/>
                <Border x:Name="Handle" Width="12" Height="32" CornerRadius="{StaticResource Radius.Small}" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Background="{StaticResource Text.Primary}"/>
            </Grid>
        </Border>
        <TextBlock Text="{Binding CompareNote}" Style="{StaticResource PanelTextStyle}"/>

        <!-- A bar Command Center did not install: added by hand, or by the Generals Online launcher -->
        <Border Style="{StaticResource PanelStyle}" Margin="{StaticResource Gap.Group}" Visibility="{Binding ShowOtherNotice, Converter={StaticResource Visible}}">
            <DockPanel>
                <c:Icon DockPanel.Dock="Left" Kind="info" Width="18" Height="18"
                        VerticalAlignment="Top" Margin="0,2,12,0" Foreground="{StaticResource Warning}"/>
                <StackPanel>
                    <TextBlock Text="{Binding OtherTitle}" Style="{StaticResource PanelTitleStyle}"/>
                    <TextBlock Text="{Binding OtherDetail}" Style="{StaticResource PanelTextStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="{StaticResource Gap.Group}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <RadioButton Grid.Column="0" GroupName="ControlBar" Style="{StaticResource ChoiceCardStyle}" VerticalAlignment="Top" IsChecked="{Binding OriginalChosen}"
                         IsEnabled="{Binding CanChoose}">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource TagStyle}" Visibility="{Binding OriginalInstalled, Converter={StaticResource Visible}}">
                            <TextBlock Text="Installed" Style="{StaticResource TagTextStyle}"/>
                        </Border>
                        <TextBlock Text="Original" Style="{StaticResource PanelTitleStyle}"/>
                    </DockPanel>
                    <TextBlock Text="The game's own control bar" Style="{StaticResource PanelTextStyle}"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Grid.Column="2" GroupName="ControlBar" Style="{StaticResource ChoiceCardStyle}" VerticalAlignment="Top" IsChecked="{Binding ProChosen}"
                         IsEnabled="{Binding CanChoose}">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource TagStyle}" Visibility="{Binding ProInstalled, Converter={StaticResource Visible}}">
                            <TextBlock Text="Installed" Style="{StaticResource TagTextStyle}"/>
                        </Border>
                        <TextBlock Text="Control Bar Pro" Style="{StaticResource PanelTitleStyle}"/>
                    </DockPanel>
                    <TextBlock Text="Larger and cleaner, version 1.2. Pick the size of your game's resolution." Style="{StaticResource PanelTextStyle}"/>
                    <ListBox Style="{StaticResource ChipListStyle}" Margin="{StaticResource Gap.Actions}" ItemsSource="{Binding Resolutions}"
                             SelectedValuePath="Value" SelectedValue="{Binding ChosenResolution}" IsEnabled="{Binding CanChoose}">
                        <!-- An explicit label, so the chip's own colour reaches the text -->
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource ButtonLabelStyle}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </RadioButton>
        </Grid>

        <!-- What Apply will do -->
        <Border Style="{StaticResource PanelStyle}" Margin="{StaticResource Gap.Group}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0" VerticalAlignment="Center"
                        Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}">
                    <TextBlock Text="Apply" Style="{StaticResource ButtonLabelStyle}"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource QuietButtonStyle}" Margin="12,0,0,0" VerticalAlignment="Center"
                        Command="{Binding DiscardCommand}" Visibility="{Binding CanDiscard, Converter={StaticResource Visible}}">
                    <TextBlock Text="Discard" Style="{StaticResource ButtonLabelStyle}"/>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ChangeText}" Style="{StaticResource PanelTitleStyle}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ChangeDetail}" Style="{StaticResource PanelTextStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Why it is safe -->
        <Border Style="{StaticResource PanelStyle}" Margin="{StaticResource Gap.Group}">
            <StackPanel>
                <TextBlock Text="Safety" Style="{StaticResource PanelTitleStyle}"/>
                <TextBlock Style="{StaticResource PanelTextStyle}" Text="Checked with SHA-256 before anything is installed."/>
                <TextBlock Style="{StaticResource PanelTextStyle}" Text="Only the .big archives are copied; scripts in the package are skipped."/>
                <TextBlock Style="{StaticResource PanelTextStyle}" Text="It changes the interface only, so it never causes a mismatch."/>
                <TextBlock Style="{StaticResource PanelTextStyle}" Text="Your previous bar is kept; Undo puts it back."/>
                <TextBlock Style="{StaticResource PanelTextStyle}" Text="Source: TheSuperHackers/GeneralsControlBar on GitHub (MIT licence)."/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
