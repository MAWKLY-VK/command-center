<UserControl x:Class="CommandCenter.Pages.Tools.HotkeyLettersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="NoteText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#A8A8C8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Style="{StaticResource NoteText}" Margin="0,0,0,12" Text="Draws each button's hotkey letter on its picture, in the bottom-left corner, so the control bar in the game shows which key to press."/>

                <DockPanel Margin="0,0,0,8">
                    <ComboBox x:Name="ArmyBox" DockPanel.Dock="Right" Width="200" Height="28" FontSize="12" SelectionChanged="Army_Changed"
                              Visibility="Collapsed"/>
                    <TextBlock x:Name="PreviewTitle" Text="PREVIEW" Style="{StaticResource GroupLabelStyle}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>

                <Border Style="{StaticResource ResultBoxStyle}">
                    <StackPanel>
                        <TextBlock x:Name="PreviewMessage" Foreground="#A7AECB" FontSize="12" TextWrapping="Wrap" Text="Loading…"/>
                        <StackPanel x:Name="PreviewRows" Visibility="Collapsed">
                            <TextBlock Text="WITHOUT LETTERS" Style="{StaticResource GroupLabelStyle}"/>
                            <WrapPanel x:Name="BeforeIcons" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                            <TextBlock Text="WITH LETTERS" Style="{StaticResource GroupLabelStyle}" Margin="0,12,0,6"/>
                            <WrapPanel x:Name="AfterIcons" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="GOOD TO KNOW" Style="{StaticResource GroupLabelStyle}" Margin="0,16,0,6"/>
                <StackPanel x:Name="LettersNotes"/>
            </StackPanel>
        </ScrollViewer>

        <!-- On or off -->
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <Button x:Name="LettersOnButton" DockPanel.Dock="Right" Content="TURN ON" Style="{StaticResource GoldButtonStyle}" Margin="10,0,0,0"
                    MinWidth="90" Click="LettersOn_Click"/>
            <Button x:Name="LettersOffButton" DockPanel.Dock="Right" Content="TURN OFF" Style="{StaticResource DiagButtonStyle}" Margin="10,0,0,0"
                    Click="LettersOff_Click"/>
            <Button x:Name="LettersUpdateButton" DockPanel.Dock="Right" Content="UPDATE LETTERS" Style="{StaticResource DiagButtonStyle}" Margin="10,0,0,0"
                    Click="LettersUpdate_Click"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="LettersState" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="LettersDetail" FontSize="11.5" Foreground="#A7AECB" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
