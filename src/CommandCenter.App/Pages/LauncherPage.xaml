<Page
    x:Class="CommandCenter.Pages.LauncherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CommandCenter.Controls"
    Background="Transparent">

    <!-- Home, the Briefing stage (ADR 0006): over the game's art, the title, PLAY, the line that says why and the data
         line at the bottom left; the last match and the game's health at the bottom right -->
    <Grid Margin="{StaticResource Page.Margin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="{StaticResource Column.Gap}"/>
            <ColumnDefinition Width="{StaticResource Column.Side}"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="640">
            <TextBlock Text="Generals Online Zero Hour" Style="{StaticResource PageTitleStyle}"/>

            <!-- PLAY, split: its words follow the state; its other half chooses Live or Test. The soft glow behind it is
                 the one glow on the screen. -->
            <Grid HorizontalAlignment="Left" Margin="{StaticResource Gap.Actions}">
                <Ellipse Fill="{StaticResource Play.Glow}" Margin="-64,-48" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PlayButtonStyle}" Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}"
                            AutomationProperties.Name="{Binding PlayLabel}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="{Binding PlayIcon}" Width="24" Height="24" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding PlayLabel}" Style="{StaticResource ButtonLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="ChannelToggle" Style="{StaticResource PlaySplitStyle}" IsEnabled="{Binding CanPlay}"
                                  Visibility="{Binding ShowChannels, Converter={StaticResource Visible}}" AutomationProperties.Name="Choose Live or Test">
                        <c:Icon Kind="chevron" Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                            <c:Icon.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </c:Icon.RenderTransform>
                        </c:Icon>
                    </ToggleButton>
                </StackPanel>
                <Popup IsOpen="{Binding IsChecked, ElementName=ChannelToggle}" PlacementTarget="{Binding ElementName=ChannelToggle}" Placement="Top"
                       StaysOpen="False" AllowsTransparency="True">
                    <Border Style="{StaticResource MenuPanelStyle}">
                        <StackPanel>
                            <RadioButton GroupName="Channel" Style="{StaticResource ChoiceStyle}" IsChecked="{Binding IsLive}">
                                <TextBlock Text="Live" Style="{StaticResource ButtonLabelStyle}"/>
                            </RadioButton>
                            <RadioButton GroupName="Channel" Style="{StaticResource ChoiceStyle}" IsChecked="{Binding IsTest}">
                                <TextBlock Text="Test" Style="{StaticResource ButtonLabelStyle}"/>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Why PLAY says what it says, in plain words, and what else the player can do here -->
            <TextBlock Text="{Binding Status}" Style="{StaticResource StateTextStyle}" TextWrapping="Wrap" Margin="{StaticResource Gap.Actions}"/>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource LinkButtonStyle}" Command="{Binding PlayAnywayCommand}" Margin="0,0,24,0"
                        Visibility="{Binding ShowPlayAnyway, Converter={StaticResource Visible}}">
                    <TextBlock Text="Play anyway" Style="{StaticResource ButtonLabelStyle}"/>
                </Button>
                <Button Style="{StaticResource LinkButtonStyle}" Command="{Binding GetGameCommand}" Margin="0,0,24,0"
                        Visibility="{Binding ShowGetGame, Converter={StaticResource Visible}}">
                    <TextBlock Text="Get the game" Style="{StaticResource ButtonLabelStyle}"/>
                </Button>
            </StackPanel>

            <!-- The match guard (P5-D3): the files that changed since the last good online match -->
            <DockPanel Visibility="{Binding ShowGuard, Converter={StaticResource Visible}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}" Command="{Binding ReviewGuardCommand}" Margin="16,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="Review" Style="{StaticResource ButtonLabelStyle}"/>
                </Button>
                <c:Icon DockPanel.Dock="Left" Kind="alert" Width="16" Height="16" Margin="0,8,8,0" VerticalAlignment="Top" Foreground="{StaticResource Warning}"/>
                <TextBlock Text="{Binding GuardText}" Style="{StaticResource StateTextStyle}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,6,0,0"/>
            </DockPanel>

            <!-- Real data only: the client's version, the channel, players online and the ping; a group of its own -->
            <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Group}">
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource DataTextStyle}"/>
                <TextBlock Text="{Binding ChannelText}" Style="{StaticResource DataTextStyle}" Margin="24,0,0,0"
                           Visibility="{Binding ShowChannels, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding PlayersText}" Style="{StaticResource DataTextStyle}" Margin="24,0,0,0"
                           Visibility="{Binding HasPlayers, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding PingText}" Style="{StaticResource DataTextStyle}" Margin="24,0,0,0"
                           Visibility="{Binding HasPing, Converter={StaticResource Visible}}"/>
            </StackPanel>
        </StackPanel>

        <!-- The two quiet panels: the last match, and the game's health -->
        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
            <Border Style="{StaticResource PanelStyle}" DataContext="{Binding LastMatch}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource QuietButtonStyle}" Margin="16,0,0,0" VerticalAlignment="Center"
                                Command="{Binding WatchCommand}" Visibility="{Binding HasMatch, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="film" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Watch" Style="{StaticResource ButtonLabelStyle}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Last match" Style="{StaticResource PanelTitleStyle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid Margin="{StaticResource Gap.Actions}" Visibility="{Binding HasMatch, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="64" Height="64" Margin="0,0,12,0" VerticalAlignment="Top" Background="{StaticResource Bg.Raised}"
                                CornerRadius="{StaticResource Radius.Small}" ClipToBounds="True" Visibility="{Binding HasPreview, Converter={StaticResource Visible}}">
                            <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Map}" Style="{StaticResource GroupTitleStyle}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Info}" Style="{StaticResource PanelTextStyle}" Margin="0,4,0,0"/>
                            <Border Style="{StaticResource TagStyle}" HorizontalAlignment="Left" Margin="{StaticResource Gap.Text}"
                                    Visibility="{Binding HasResult, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding Result}" Style="{StaticResource TagTextStyle}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <StackPanel Visibility="{Binding NoMatch, Converter={StaticResource Visible}}">
                        <TextBlock Text="No replays yet." Style="{StaticResource StateTextStyle}" Margin="{StaticResource Gap.Text}"/>
                        <TextBlock Text="Your last match shows here after a game." Style="{StaticResource PanelTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelStyle}" Margin="{StaticResource Gap.Group}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource QuietButtonStyle}" Margin="16,0,0,0" VerticalAlignment="Center"
                                Command="{Binding ReviewHealthCommand}" Visibility="{Binding HealthHasIssues, Converter={StaticResource Visible}}">
                            <TextBlock Text="Review" Style="{StaticResource ButtonLabelStyle}"/>
                        </Button>
                        <TextBlock Text="Health" Style="{StaticResource PanelTitleStyle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="{StaticResource Gap.Actions}">
                        <c:Icon DockPanel.Dock="Left" Kind="{Binding HealthSign}" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top">
                            <!-- The state's colour beside its sign and its words -->
                            <c:Icon.Style>
                                <Style TargetType="c:Icon">
                                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HealthIsClear}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HealthIsProblem}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Problem}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HealthReady}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </c:Icon.Style>
                        </c:Icon>
                        <TextBlock Text="{Binding HealthText}" Style="{StaticResource StateTextStyle}" TextWrapping="Wrap"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
