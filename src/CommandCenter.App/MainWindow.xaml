<Window
    x:Class="CommandCenter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:pages="clr-namespace:CommandCenter.Pages"
    xmlns:c="clr-namespace:CommandCenter.Controls"
    Title="Command Center"
    Icon="Assets/app.ico"
    Width="1100" Height="640" MinWidth="980" MinHeight="600"
    WindowStyle="None"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource Bg.Window}"
    FontFamily="{StaticResource Font.Text}"
    UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="64"
            ResizeBorderThickness="5"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root" ClipToBounds="True">

        <!-- The art (plan 3-c): the game's picture on Home, tinted once, and its blurred, darkened copy behind the other
             pages. A copy without the art gets the drawn background. Nothing here is blurred live. -->
        <Grid x:Name="Backdrop" IsHitTestVisible="False" Background="{StaticResource Bg.Window}">
            <Grid x:Name="DrawnBackdrop" Visibility="Collapsed">
                <Rectangle Fill="{StaticResource Art.DrawnLight}"/>
                <Rectangle Fill="{StaticResource Art.DrawnGlow}"/>
                <Image Source="/Assets/logo.png" Width="440" Height="440" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,104,96,0" Opacity="0.14"/>
            </Grid>
            <Image x:Name="PagesArt" Stretch="UniformToFill" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Image x:Name="HomeArtImage" Stretch="UniformToFill" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.RenderTransform>
                    <ScaleTransform/>
                </Image.RenderTransform>
            </Image>
            <!-- Home: the text side and the bottom stay readable over the art or the drawn background -->
            <Grid x:Name="HomeScrims" Opacity="0">
                <Rectangle Fill="{StaticResource Art.ScrimLeft}"/>
                <Rectangle Fill="{StaticResource Art.ScrimBottom}"/>
            </Grid>
            <!-- The other pages over the drawn background, dimmed the way the art's copy is darkened -->
            <Rectangle x:Name="PagesScrim" Fill="{StaticResource Bg.PanelOverArt}" Opacity="0"/>
            <Rectangle Fill="{StaticResource Art.Vignette}"/>
            <Rectangle x:Name="Grain" Opacity="{StaticResource Art.Grain}"/>
        </Grid>

        <!-- Pages -->
        <Frame x:Name="ContentFrame" Margin="0,64,0,0" Background="Transparent" NavigationUIVisibility="Hidden"
               Navigated="ContentFrame_Navigated" Focusable="False"/>

        <!-- Top bar (P5-D1): the name, the five tabs, then Settings and Help and the window buttons -->
        <Grid x:Name="TopBar" Height="64" VerticalAlignment="Top" Background="{StaticResource Art.ScrimTop}">
            <DockPanel Margin="20,0,8,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Image Source="/Assets/logo.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Command Center" Style="{StaticResource BrandStyle}" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="TabHome" Style="{StaticResource FrameTabStyle}" Checked="Tab_Checked" Tag="home">
                        <TextBlock Text="Home" Style="{StaticResource FrameTabLabelStyle}"/>
                    </RadioButton>
                    <RadioButton x:Name="TabReplays" Style="{StaticResource FrameTabStyle}" Checked="Tab_Checked" Tag="replays">
                        <TextBlock Text="Replays" Style="{StaticResource FrameTabLabelStyle}"/>
                    </RadioButton>
                    <RadioButton x:Name="TabMaps" Style="{StaticResource FrameTabStyle}" Checked="Tab_Checked" Tag="maps">
                        <TextBlock Text="Maps" Style="{StaticResource FrameTabLabelStyle}"/>
                    </RadioButton>
                    <RadioButton x:Name="TabHotkeys" Style="{StaticResource FrameTabStyle}" Checked="Tab_Checked" Tag="hotkeys">
                        <TextBlock Text="Hotkeys" Style="{StaticResource FrameTabLabelStyle}"/>
                    </RadioButton>
                    <RadioButton x:Name="TabHealth" Style="{StaticResource FrameTabStyle}" Checked="Tab_Checked" Tag="health">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Health" Style="{StaticResource FrameTabLabelStyle}"/>
                            <Border x:Name="HealthBadge" Style="{StaticResource CountBadgeStyle}" Margin="8,0,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="HealthBadgeText" Style="{StaticResource CountBadgeTextStyle}"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Button DockPanel.Dock="Right" Style="{StaticResource WindowButtonStyle}" Click="Close_Click" ToolTip="Close"
                        AutomationProperties.Name="Close">
                    <c:Icon Kind="close" Width="14" Height="14"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource WindowButtonStyle}" Click="Minimize_Click" ToolTip="Minimize"
                        AutomationProperties.Name="Minimize">
                    <c:Icon Kind="minus" Width="14" Height="14"/>
                </Button>
                <RadioButton x:Name="TabHelp" DockPanel.Dock="Right" Style="{StaticResource FrameTabStyle}" Checked="Tab_Checked"
                             Tag="help" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="info" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Help" Style="{StaticResource FrameTabLabelStyle}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabSettings" DockPanel.Dock="Right" Style="{StaticResource FrameTabStyle}" Checked="Tab_Checked"
                             Tag="settings">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="sliders" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Settings" Style="{StaticResource FrameTabLabelStyle}"/>
                    </StackPanel>
                </RadioButton>
            </DockPanel>
        </Grid>

        <!-- Short message after an action, with Undo when the action can be taken back -->
        <Border x:Name="ToastBox" Style="{StaticResource ToastStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24" MaxWidth="680" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <c:Icon x:Name="ToastIcon" Kind="alert" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"
                        Foreground="{StaticResource Problem}" Visibility="Collapsed"/>
                <StackPanel VerticalAlignment="Center" MaxWidth="480">
                    <!-- Only the one-time English-only notice has an Arabic paragraph -->
                    <TextBlock x:Name="ToastArabic" Style="{StaticResource ToastArabicTextStyle}" Visibility="Collapsed"/>
                    <TextBlock x:Name="ToastText" Style="{StaticResource ToastTextStyle}"/>
                </StackPanel>
                <Button x:Name="ToastAction" Style="{StaticResource QuietButtonStyle}" Margin="16,0,0,0" Content="UNDO"
                        Click="ToastAction_Click" Visibility="Collapsed"/>
                <Button Style="{StaticResource WindowButtonStyle}" Width="32" Height="32" Margin="8,0,0,0" Click="ToastClose_Click"
                        AutomationProperties.Name="Close">
                    <c:Icon Kind="close" Width="13" Height="13"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Mandatory update: covers everything until the new version is installed -->
        <pages:UpdateOverlay x:Name="UpdateOverlay"/>
    </Grid>
</Window>
