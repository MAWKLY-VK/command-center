<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The file stays CommandCenter.exe, so the forced update keeps reaching every copy (docs/adr/0009) -->
    <AssemblyName>CommandCenter</AssemblyName>
    <RootNamespace>CommandCenter</RootNamespace>
    <!-- The program's version: tools/publish.ps1 reads it, and UpdateService compares against it -->
    <Version>0.5.0</Version>
    <Product>Command Center</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 32-bit on the .NET 10 Desktop Runtime (x86) that the Generals Online launcher installs and runs on itself,
         so the program stays a few megabytes instead of carrying its own copy of .NET -->
    <PlatformTarget>x86</PlatformTarget>
    <RollForward>Major</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- A test build (TestKeys=true) also trusts a test key named on its command line. CI and publish never set it, so a
       released Command Center trusts only the maintainer's key (ADR 0007). -->
  <PropertyGroup Condition="'$(TestKeys)' == 'true'">
    <DefineConstants>$(DefineConstants);TEST_KEYS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.jpg" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
    <!-- Barlow, Barlow Condensed and JetBrains Mono (OFL), with their licences, so every PC shows the same type -->
    <Resource Include="Theme\Fonts\*.ttf" />
    <Resource Include="Theme\Fonts\*-OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommandCenter.Core\CommandCenter.Core.csproj" />
  </ItemGroup>

  <!-- View models for the pages that move to MVVM in phases 5 and 6 (docs/adr/0004) -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CommandCenter.Tests" />
  </ItemGroup>

  <!-- The services' namespaces, so the pages need no using line for each -->
  <ItemGroup>
    <Using Include="CommandCenter.Core.Content" />
    <Using Include="CommandCenter.Core.Diagnostics" />
    <Using Include="CommandCenter.Core.Game" />
    <Using Include="CommandCenter.Core.Imaging" />
    <Using Include="CommandCenter.Core.Integrity" />
    <Using Include="CommandCenter.Core.Net" />
    <Using Include="CommandCenter.Core.Safety" />
    <Using Include="CommandCenter.Core.Settings" />
    <Using Include="CommandCenter.Core.Text" />
    <Using Include="CommandCenter.Core.Updates" />
  </ItemGroup>

</Project>
